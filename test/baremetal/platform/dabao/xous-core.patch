diff --git a/baremetal/src/mldsa.rs b/baremetal/src/mldsa.rs
new file mode 100644
index 0000000..ab1e382
--- /dev/null
+++ b/baremetal/src/mldsa.rs
@@ -0,0 +1,59 @@
+//! Runs an mldsa-native test binary linked in as a static library.
+//!
+//! The C side provides `mld_bench_entry`, which runs the test's `main()` with
+//! a heap carved out of the Rust allocator, and prints through `mld_putchar`.
+//! Every exit path ends in `mld_bench_exit`, which reports the return code as
+//! `DABAO_EXIT <rc>` and resets the chip back into boot1. A watchdog, fed on
+//! every line of output, resets the chip if the test hangs or traps.
+
+use alloc::vec::Vec;
+use core::sync::atomic::Ordering;
+
+use bao1x_hal::wdt::Wdt;
+use utralib::*;
+
+extern "C" {
+    fn mld_bench_entry(heap: *mut u8, heap_len: usize) -> i32;
+}
+
+const C_HEAP_LEN: usize = 128 * 1024;
+
+fn usb_tx_empty() -> bool { critical_section::with(|cs| crate::USB_TX.borrow(cs).borrow().is_empty()) }
+
+fn flush() {
+    while !usb_tx_empty() {
+        crate::platform::usb::glue::flush_tx();
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn mld_putchar(c: u8) {
+    critical_section::with(|cs| crate::USB_TX.borrow(cs).borrow_mut().push_back(c));
+    if c == b'\n' {
+        flush();
+        Wdt::new().feed();
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn mld_bench_exit(rc: i32) -> ! {
+    for c in alloc::format!("DABAO_EXIT {}\r\n", rc).bytes() {
+        mld_putchar(c);
+    }
+    flush();
+    // wait for the last packet to leave before resetting
+    while !crate::platform::usb::TX_IDLE.load(Ordering::SeqCst) {}
+    crate::delay(100);
+    let mut csr = CSR::new(utra::sysctrl::HW_SYSCTRL_BASE as *mut u32);
+    csr.wo(utra::sysctrl::SFR_RCURST0, 0x0000_55aa);
+    loop {}
+}
+
+pub fn run() -> ! {
+    // The watchdog counts at 43.75 MHz: a full reload lasts about 98 s, and
+    // the reset follows a second expiry without a feed.
+    Wdt::new().enable(0xFFFF_FFFF, true);
+    let mut heap: Vec<u8> = Vec::with_capacity(C_HEAP_LEN);
+    let rc = unsafe { mld_bench_entry(heap.as_mut_ptr(), C_HEAP_LEN) };
+    mld_bench_exit(rc)
+}
