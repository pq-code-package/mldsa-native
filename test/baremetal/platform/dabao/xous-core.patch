+/// Load address of the byte at virtual address `vaddr`, from the program headers.
+fn load_address(elf: &ElfFile, vaddr: u64) -> Option<u64> {
+    elf.program_iter()
+        .find(|ph| {
+            ph.get_type() == Ok(ProgramType::Load)
+                && ph.virtual_addr() <= vaddr
+                && vaddr < ph.virtual_addr() + ph.mem_size()
+        })
+        .map(|ph| ph.physical_addr() + (vaddr - ph.virtual_addr()))
+}
