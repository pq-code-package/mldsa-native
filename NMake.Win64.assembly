    $(AS) $(ASFLAGS) -predefine "FUNC_NAME SETS \"mld_$(<B)_asm\"" -o $(MLDSA87_BUILD_DIR)\alloc\mldsa\fips202\aarch64\$(<B).obj $<
    @python fix_pdata.py $(MLDSA87_BUILD_DIR)\alloc\mldsa\fips202\aarch64\$(<B).obj

