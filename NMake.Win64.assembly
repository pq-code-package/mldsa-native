#
# ML-DSA 44
#

!IFDEF ARM64

#
# Comment from author: armasm64.exe has bugs:
# a) ALIGN 16 in code sections does NOT emit
#    correct 'HINT #0x0' (NOPs) but zeros
# b) 'RELOC 2' for PDATA sections meaning
#    IMAGE_REL_ARM64_ADDR32NB still emit ADDR64
#    instead
#
# The bottom line is: you may also use clang-cl
# to compile Aarch64 assembly stuff on MS Windows.
# You have to add:
# --target=aarch64-pc-windows-msvc
# in this case.
# Claude Code provided the fix_pdata.py script,
# which performs well here, though.
#
# clang-cl works for ARM64 but obviously not for
# AMD64 assembly (ml64.exe is used in this case)
# because we had to convert the SysV AMD64 ABI
# to MS AMD64 ABI by hand...
#

# compilation of C files for mldsa44 (assembly part)
{mldsa\src\native\aarch64\src}.c{$(MLDSA44_BUILD_DIR)\mldsa\aarch64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\aarch64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\aarch64
    $(CC) $(CFLAGS) /D MLD_CONFIG_PARAMETER_SET=44 /c /Fo$(MLDSA44_BUILD_DIR)\mldsa\aarch64\ $<

# compilation of ASM files for mldsa44 (assembly part)
{mldsa\src\native\aarch64\win64}.asm{$(MLDSA44_BUILD_DIR)\mldsa\aarch64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\aarch64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\aarch64
    $(AS) $(ASFLAGS) -predefine "FUNC_NAME SETS \"PQCP_MLDSA_NATIVE_MLDSA44_$(<B:mldsa_=)_asm\"" -o $(MLDSA44_BUILD_DIR)\mldsa\aarch64\$(<B).obj $<
    @python fix_pdata.py $(MLDSA44_BUILD_DIR)\mldsa\aarch64\$(<B).obj

# compilation of C files for mldsa44 (assembly part, FIPS 202)
{mldsa\src\fips202\native\aarch64\src}.c{$(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64
    $(CC) $(CFLAGS) /D MLD_CONFIG_PARAMETER_SET=44 /c /Fo$(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64\ $<

# compilation of ASM files for mldsa44 (assembly part, FIPS 202)
{mldsa\src\fips202\native\aarch64\win64}.asm{$(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64
    $(AS) $(ASFLAGS) -predefine "FUNC_NAME SETS \"PQCP_MLDSA_NATIVE_MLDSA44_$(<B)_asm\"" -o $(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64\$(<B).obj $<
    @python fix_pdata.py $(MLDSA44_BUILD_DIR)\mldsa\fips202\aarch64\$(<B).obj

!ELSE

# compilation of C files for mldsa44 (assembly part)
{mldsa\src\native\x86_64\src}.c{$(MLDSA44_BUILD_DIR)\mldsa\x86_64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\x86_64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\x86_64
    $(CC) $(CFLAGS) /D MLD_CONFIG_PARAMETER_SET=44 /c /Fo$(MLDSA44_BUILD_DIR)\mldsa\x86_64\ $<

# compilation of ASM files for mldsa44 (assembly part)
{mldsa\src\native\x86_64\win64}.asm{$(MLDSA44_BUILD_DIR)\mldsa\x86_64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\x86_64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\x86_64
    $(AS) $(ASFLAGS) /D FUNC_NAME=PQCP_MLDSA_NATIVE_MLDSA44_$(<B:mldsa_=)_asm /Fo$(MLDSA44_BUILD_DIR)\mldsa\x86_64\$(<B).obj $<

# compilation of C files for mldsa44 (assembly part, FIPS 202)
{mldsa\src\fips202\native\x86_64\src}.c{$(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64
    $(CC) $(CFLAGS) /D MLD_CONFIG_PARAMETER_SET=44 /c /Fo$(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64\ $<

# compilation of ASM files for mldsa44 (assembly part, FIPS 202)
{mldsa\src\fips202\native\x86_64\win64}.asm{$(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64}.obj:
    @if NOT EXIST $(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64 mkdir $(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64
    $(AS) $(ASFLAGS) /D FUNC_NAME=PQCP_MLDSA_NATIVE_MLDSA44_$(<B)_asm /Fo$(MLDSA44_BUILD_DIR)\mldsa\fips202\x86_64\$(<B).obj $<

!ENDIF

