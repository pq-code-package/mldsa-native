    @if NOT EXIST $(MLDSA87_BUILD_DIR)\alloc\mldsa\aarch64 mkdir $(MLDSA87_BUILD_DIR)\alloc\mldsa\aarch64
    $(AS) $(ASFLAGS) -predefine "FUNC_NAME SETS \"$(<B:mldsa_=mld_)_asm\"" -o $(MLDSA87_BUILD_DIR)\alloc\mldsa\aarch64\$(<B).obj $<
    @python fix_pdata.py $(MLDSA87_BUILD_DIR)\alloc\mldsa\aarch64\$(<B).obj

# compilation of C files for mldsa87 (assembly part, FIPS 202)
{mldsa\src\fips202\native\aarch64\src}.c{$(MLDSA87_BUILD_DIR)\alloc\mldsa\fips202\aarch64}.obj:
    @if NOT EXIST $(MLDSA87_BUILD_DIR)\alloc\mldsa\fips202\aarch64 mkdir $(MLDSA87_BUILD_DIR)\alloc\mldsa\fips202\aarch64
    $(CC) $(ALLOC_CFLAGS) /D MLD_CONFIG_PARAMETER_SET=87 /c /Fo$(MLDSA87_BUILD_DIR)\alloc\mldsa\fips202\aarch64\ $<

