# mldsa_poly_chknorm_aarch64_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mldsa_poly_chknorm_aarch64_asm MLDSA_POLY_CHKNORM_SUBROUTINE_CORRECT
  |- !a:int64 x:(num -> int32) bound:int64 pc:num returnaddress:int64.
       nonoverlapping ((word pc : int64), LENGTH mldsa_poly_chknorm_mc) (a, 1024)
       ==> ensures arm
             (\s:armstate.
               aligned_bytes_loaded s (word pc : int64) mldsa_poly_chknorm_mc
               /\ read PC s = (word pc : int64)
               /\ read X30 s = returnaddress
               /\ C_ARGUMENTS [a; bound] s
               /\ &0 <= ival bound
               /\ ival bound < &2 pow 31
               /\ (!i:num.
                    i < 256
                    ==> read (memory :> bytes32 (word_add a (word (4 * i) : int64))) s = x i)
               /\ (!i:num. i < 256 ==> abs (ival (x i)) < &2 pow 31))
             (\s:armstate.
               read PC s = returnaddress
               /\ read X0 s
                  = (word (bitval (?i:num. i < 256 /\ abs (ival (x i)) >= ival bound)) : int64))
             MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI

theorem mldsa_poly_chknorm_aarch64_asm MLDSA_POLY_CHKNORM_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> num -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a:int64 bound:int64 pc:num returnaddress:int64.
         nonoverlapping ((word pc : int64), LENGTH mldsa_poly_chknorm_mc) (a, 1024)
         ==> ensures arm
               (\s:armstate.
                 aligned_bytes_loaded s (word pc : int64) mldsa_poly_chknorm_mc
                 /\ read PC s = (word pc : int64)
                 /\ read X30 s = returnaddress
                 /\ C_ARGUMENTS [a; bound] s
                 /\ read events s = e)
               (\s:armstate.
                 read PC s = returnaddress
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events a pc returnaddress
                      /\ memaccess_inbounds e2 [a, 1024] (NIL : (int64 # num) list)))
               (\s:armstate s':armstate. T)
