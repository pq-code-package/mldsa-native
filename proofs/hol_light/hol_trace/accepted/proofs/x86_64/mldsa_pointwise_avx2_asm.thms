         /\ aligned 32 consts
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_pointwise_mc) (a, 1024)
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_pointwise_mc) (b, 1024)
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_pointwise_mc) (consts, 2496)
         /\ nonoverlapping (a, 1024) (b, 1024)
         /\ nonoverlapping (a, 1024) (consts, 2496)
         /\ nonoverlapping (b, 1024) (consts, 2496)
         /\ nonoverlapping (stackpointer, 8) (a, 1024)
         /\ nonoverlapping (stackpointer, 8) (b, 1024)
