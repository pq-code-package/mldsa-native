# mldsa_rej_uniform_eta2_avx2_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mldsa_rej_uniform_eta2_avx2_asm MLDSA_REJ_UNIFORM_ETA2_NOIBT_SUBROUTINE_CORRECT
  |- !res:int64 buf:int64 table:int64 inlist:(byte list) pc:num stackpointer:int64
      returnaddress:int64.
       LENGTH inlist = 136
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc) (res, 1024)
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc) (buf, 136)
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc) (table, 2048)
       /\ nonoverlapping (res, 1024) (buf, 136)
       /\ nonoverlapping (res, 1024) (table, 2048)
       /\ nonoverlapping (stackpointer, 8) (res, 1024)
       /\ nonoverlapping (stackpointer, 8) (buf, 136)
       /\ nonoverlapping (stackpointer, 8) (table, 2048)
       /\ nonoverlapping (stackpointer, 8) ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mldsa_rej_uniform_eta2_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [res; buf; table] s
               /\ read (memory :> bytes (buf, 136)) s = num_of_wordlist inlist
               /\ read (memory :> bytes (table, 2048)) s = num_of_wordlist mldsa_rej_uniform_table)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (let outlist:(int32 list) = SUB_LIST (0, 256) (REJ_SAMPLE_ETA2_BYTES inlist) in
                  let outlen:num = LENGTH outlist in
                  outlen <= 256
                  /\ C_RETURN s = (word outlen : int64)
                  /\ read (memory :> bytes (res, 4 * outlen)) s = num_of_wordlist outlist
                  /\ (!i:num.
                       i < outlen ==> ival (EL i outlist) < &3 /\ -&3 < ival (EL i outlist))))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (res, 1024)])

theorem mldsa_rej_uniform_eta2_avx2_asm MLDSA_REJ_UNIFORM_ETA2_NOIBT_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> int64 -> num -> bool list -> int64 -> int64 ->
          (64 address_uarch_event) list).
       !res:int64 buf:int64 table:int64 inlist:(byte list) e:((64 address_uarch_event) list) pc:num
        stackpointer:int64 returnaddress:int64.
         LENGTH inlist = 136
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc) (res, 1024)
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc) (buf, 136)
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc) (table, 2048)
         /\ nonoverlapping (res, 1024) (buf, 136)
         /\ nonoverlapping (res, 1024) (table, 2048)
         /\ nonoverlapping (stackpointer, 8) (res, 1024)
         /\ nonoverlapping (stackpointer, 8) (buf, 136)
         /\ nonoverlapping (stackpointer, 8) (table, 2048)
         /\ nonoverlapping (stackpointer, 8) ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_tmc)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mldsa_rej_uniform_eta2_tmc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [res; buf; table] s
                 /\ read (memory :> bytes (buf, 136)) s = num_of_wordlist inlist
                 /\ read (memory :> bytes (table, 2048)) s = num_of_wordlist mldsa_rej_uniform_table
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2
                         = f_events res buf table pc (REJ_MASK_ETA2 inlist) stackpointer
                             returnaddress
                      /\ memaccess_inbounds e2 [buf, 136; table, 2048; stackpointer, 8]
                           [res, 1024]))
               (MAYCHANGE [RSP]
               ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
               ,, MAYCHANGE [memory :> bytes (res, 1024)])

theorem mldsa_rej_uniform_eta2_avx2_asm MLDSA_REJ_UNIFORM_ETA2_SUBROUTINE_CORRECT
  |- !res:int64 buf:int64 table:int64 inlist:((4 word) list) pc:num stackpointer:int64
      returnaddress:int64.
       LENGTH inlist = 272
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_mc) (res, 1024)
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_mc) (buf, 136)
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_mc) (table, 2048)
       /\ nonoverlapping (res, 1024) (buf, 136)
       /\ nonoverlapping (res, 1024) (table, 2048)
       /\ nonoverlapping (stackpointer, 8) (res, 1024)
       /\ nonoverlapping (stackpointer, 8) (buf, 136)
       /\ nonoverlapping (stackpointer, 8) (table, 2048)
       /\ nonoverlapping (stackpointer, 8) ((word pc : int64), LENGTH mldsa_rej_uniform_eta2_mc)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mldsa_rej_uniform_eta2_mc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [res; buf; table] s
               /\ read (memory :> bytes (buf, 136)) s = num_of_wordlist inlist
               /\ read (memory :> bytes (table, 2048)) s = num_of_wordlist mldsa_rej_uniform_table)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (let outlist:(int32 list) = SUB_LIST (0, 256) (REJ_SAMPLE_ETA2 inlist) in
                  let outlen:num = LENGTH outlist in
                  outlen <= 256
                  /\ C_RETURN s = (word outlen : int64)
                  /\ read (memory :> bytes (res, 4 * outlen)) s = num_of_wordlist outlist
                  /\ (!i:num.
                       i < outlen ==> ival (EL i outlist) < &3 /\ -&3 < ival (EL i outlist))))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (res, 1024)])

