# mldsa_polyz_unpack_17_avx2_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mldsa_polyz_unpack_17_avx2_asm MLDSA_POLYZ_UNPACK_17_NOIBT_SUBROUTINE_CORRECT
  |- !r:int64 b:int64 l:((18 word) list) pc:num stackpointer:int64 returnaddress:int64.
       aligned 32 r
       /\ ALL (nonoverlapping ((word pc : int64), LENGTH mldsa_polyz_unpack_17_tmc)) [r, 1024]
       /\ LENGTH l = 256
       /\ ALL (nonoverlapping (r, 1024)) [(word pc : int64), LENGTH mldsa_polyz_unpack_17_tmc;
                                          b, 576]
       /\ nonoverlapping (stackpointer, 8) (r, 1024)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mldsa_polyz_unpack_17_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [r; b] s
               /\ read (memory :> bytes (b, 576)) s = num_of_wordlist l)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ read (memory :> bytes (r, 1024)) s = num_of_wordlist (MAP zunpack17 l)
               /\ (!i:num.
                    i < 256
                    ==> -(int_of_num (2 EXP 17) - &1) <= ival (EL i (MAP zunpack17 l))
                        /\ ival (EL i (MAP zunpack17 l)) <= int_of_num (2 EXP 17)))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (r, 1024)])

theorem mldsa_polyz_unpack_17_avx2_asm MLDSA_POLYZ_UNPACK_17_NOIBT_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) r:int64 b:int64 l:((18 word) list) pc:num
        stackpointer:int64 returnaddress:int64.
         aligned 32 r
         /\ ALL (nonoverlapping ((word pc : int64), LENGTH mldsa_polyz_unpack_17_tmc)) [r, 1024]
         /\ LENGTH l = 256
         /\ ALL (nonoverlapping (r, 1024)) [(word pc : int64), LENGTH mldsa_polyz_unpack_17_tmc;
                                            b, 576]
         /\ nonoverlapping (stackpointer, 8) (r, 1024)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mldsa_polyz_unpack_17_tmc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [r; b] s
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events b r pc stackpointer returnaddress
                      /\ memaccess_inbounds e2 [b, 576; r, 1024; stackpointer, 8]
                           [r, 1024; stackpointer, 8]))
               (\s:x86state s':x86state. T)

