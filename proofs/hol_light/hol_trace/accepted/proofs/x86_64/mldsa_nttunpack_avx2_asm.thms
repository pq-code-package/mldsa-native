# mldsa_nttunpack_avx2_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mldsa_nttunpack_avx2_asm MLDSA_NTTUNPACK_NOIBT_SUBROUTINE_CORRECT
  |- !a:int64 l:(int32 list) pc:num stackpointer:int64 returnaddress:int64.
       aligned 32 a
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_nttunpack_tmc) (a, 1024)
       /\ nonoverlapping (stackpointer, 8) (a, 1024)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mldsa_nttunpack_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [a] s
               /\ read (memory :> bytes (a, 1024)) s = num_of_wordlist l)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (LENGTH l = 256
                  ==> read (memory :> bytes (a, 1024)) s = num_of_wordlist (unpack_nttunpack l)))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (a, 1024)])

theorem mldsa_nttunpack_avx2_asm MLDSA_NTTUNPACK_NOIBT_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a:int64 pc:num stackpointer:int64 returnaddress:int64.
         aligned 32 a
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_nttunpack_tmc) (a, 1024)
         /\ nonoverlapping (stackpointer, 8) (a, 1024)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mldsa_nttunpack_tmc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [a] s
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events a pc stackpointer returnaddress
                      /\ memaccess_inbounds e2 [a, 1024; stackpointer, 8]
                           [a, 1024; stackpointer, 0]))
               (MAYCHANGE [RSP]
               ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
               ,, MAYCHANGE [memory :> bytes (a, 1024)])

theorem mldsa_nttunpack_avx2_asm MLDSA_NTTUNPACK_SUBROUTINE_CORRECT
  |- !a:int64 l:(int32 list) pc:num stackpointer:int64 returnaddress:int64.
       aligned 32 a
       /\ nonoverlapping ((word pc : int64), LENGTH mldsa_nttunpack_mc) (a, 1024)
       /\ nonoverlapping (stackpointer, 8) (a, 1024)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mldsa_nttunpack_mc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [a] s
               /\ read (memory :> bytes (a, 1024)) s = num_of_wordlist l)
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (LENGTH l = 256
                  ==> read (memory :> bytes (a, 1024)) s = num_of_wordlist (unpack_nttunpack l)))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (a, 1024)])

theorem mldsa_nttunpack_avx2_asm MLDSA_NTTUNPACK_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a:int64 pc:num stackpointer:int64 returnaddress:int64.
         aligned 32 a
         /\ nonoverlapping ((word pc : int64), LENGTH mldsa_nttunpack_mc) (a, 1024)
         /\ nonoverlapping (stackpointer, 8) (a, 1024)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mldsa_nttunpack_mc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [a] s
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events a pc stackpointer returnaddress
                      /\ memaccess_inbounds e2 [a, 1024; stackpointer, 8]
                           [a, 1024; stackpointer, 0]))
               (MAYCHANGE [RSP]
               ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
               ,, MAYCHANGE [memory :> bytes (a, 1024)])
