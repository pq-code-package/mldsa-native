theorem mldsa_poly_chknorm_avx2_asm MLDSA_POLY_CHKNORM_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a:int64 bound:int64 pc:num stackpointer:int64
        returnaddress:int64.
         nonoverlapping ((word pc : int64), LENGTH mldsa_poly_chknorm_mc) (a, 1024)
         /\ nonoverlapping (stackpointer, 8) (a, 1024)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mldsa_poly_chknorm_mc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
