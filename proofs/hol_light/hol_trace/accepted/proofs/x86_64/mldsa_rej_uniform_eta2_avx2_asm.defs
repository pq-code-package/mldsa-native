# mldsa_rej_uniform_eta2_avx2_asm
#
# The definitions that the main theorems use beyond the shared files
# in accepted/base and accepted/spec. Written by `hol-trace outline`
# or `hol-trace compare --accept`. check-binary compares the byte list
# with functions in binaries, through proofs/hol_light/bind.yml.
# The notation is explained in proofs/hol_light/hol_trace/accepted/README.md.

definition REJ_MASK_ETA2
  |- REJ_MASK_ETA2
     = (specification "REJ_MASK_ETA2" REJ_MASK_ETA2:(byte list -> bool list).
         !l:(byte list). REJ_MASK_ETA2 l = MAP (\x:int16. val x < 15) (NIBBLES_OF_BYTES l))

definition REJ_NIBBLES_ETA2
  |- REJ_NIBBLES_ETA2
     = (specification "REJ_NIBBLES_ETA2" REJ_NIBBLES_ETA2:(byte list -> int16 list).
         !l:(byte list). REJ_NIBBLES_ETA2 l = FILTER (\x:int16. val x < 15) (NIBBLES_OF_BYTES l))

definition REJ_SAMPLE_ETA2_BYTES
  |- REJ_SAMPLE_ETA2_BYTES
     = (specification "REJ_SAMPLE_ETA2_BYTES" REJ_SAMPLE_ETA2_BYTES:(byte list -> int32 list).
         !l:(byte list).
           REJ_SAMPLE_ETA2_BYTES l
           = MAP
               (\x:int16.
                 (word_sx (word_sub (word 2 : int16) (word_umod x (word 5 : int16))) : int32))
               (REJ_NIBBLES_ETA2 l))

