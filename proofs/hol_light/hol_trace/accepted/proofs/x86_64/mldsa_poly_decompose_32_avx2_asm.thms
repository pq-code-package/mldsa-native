                    ==> ival (read (memory :> bytes32 (word_add a (word (4 * i) : int64))) s)
                        = SND (mldsa_decompose_32 (val (x i))))
               /\ (!i:num.
                    i < 256
                    ==> val (read (memory :> bytes32 (word_add a1 (word (4 * i) : int64))) s) <= 15)
