# mldsa_poly_decompose_32_avx2_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mldsa_poly_decompose_32_avx2_asm MLDSA_POLY_DECOMPOSE_32_NOIBT_SUBROUTINE_CORRECT
  |- !a1:int64 a:int64 x:(num -> int32) pc:num stackpointer:int64 returnaddress:int64.
       aligned 32 a1
       /\ aligned 32 a
       /\ ALL (nonoverlapping ((word pc : int64), LENGTH mldsa_decompose32_tmc)) [a1, 1024; a, 1024]
       /\ nonoverlapping (a1, 1024) (a, 1024)
       /\ nonoverlapping (stackpointer, 8) (a1, 1024)
       /\ nonoverlapping (stackpointer, 8) (a, 1024)
       ==> ensures x86
             (\s:x86state.
               bytes_loaded s (word pc : int64) mldsa_decompose32_tmc
               /\ read RIP s = (word pc : int64)
               /\ read RSP s = stackpointer
               /\ read (memory :> bytes64 stackpointer) s = returnaddress
               /\ C_ARGUMENTS [a1; a] s
               /\ (!i:num.
                    i < 256
                    ==> read (memory :> bytes32 (word_add a (word (4 * i) : int64))) s = x i)
               /\ (!i:num. i < 256 ==> val (x i) < 8380417))
             (\s:x86state.
               read RIP s = returnaddress
               /\ read RSP s = word_add stackpointer (word 8 : int64)
               /\ (!i:num.
                    i < 256
                    ==> val (read (memory :> bytes32 (word_add a1 (word (4 * i) : int64))) s)
                        = FST (mldsa_decompose_32 (val (x i))))
               /\ (!i:num.
                    i < 256
                    ==> ival (read (memory :> bytes32 (word_add a (word (4 * i) : int64))) s)
                        = SND (mldsa_decompose_32 (val (x i))))
               /\ (!i:num.
                    i < 256
                    ==> val (read (memory :> bytes32 (word_add a1 (word (4 * i) : int64))) s) <= 15)
               /\ (!i:num.
                    i < 256
                    ==> -&261888
                        <= ival (read (memory :> bytes32 (word_add a (word (4 * i) : int64))) s)
                        /\ ival (read (memory :> bytes32 (word_add a (word (4 * i) : int64))) s)
                           <= &261888))
             (MAYCHANGE [RSP]
             ,, MAYCHANGE_REGS_AND_FLAGS_PERMITTED_BY_ABI
             ,, MAYCHANGE [memory :> bytes (a1, 1024)]
             ,, MAYCHANGE [memory :> bytes (a, 1024)])

theorem mldsa_poly_decompose_32_avx2_asm MLDSA_POLY_DECOMPOSE_32_NOIBT_SUBROUTINE_SAFE
  |- ?f_events:(int64 -> int64 -> num -> int64 -> int64 -> (64 address_uarch_event) list).
       !e:((64 address_uarch_event) list) a1:int64 a:int64 pc:num stackpointer:int64
        returnaddress:int64.
         aligned 32 a1
         /\ aligned 32 a
         /\ ALL (nonoverlapping ((word pc : int64), LENGTH mldsa_decompose32_tmc))
              [a1, 1024; a, 1024]
         /\ nonoverlapping (a1, 1024) (a, 1024)
         /\ nonoverlapping (stackpointer, 8) (a1, 1024)
         /\ nonoverlapping (stackpointer, 8) (a, 1024)
         ==> ensures x86
               (\s:x86state.
                 bytes_loaded s (word pc : int64) mldsa_decompose32_tmc
                 /\ read RIP s = (word pc : int64)
                 /\ read RSP s = stackpointer
                 /\ read (memory :> bytes64 stackpointer) s = returnaddress
                 /\ C_ARGUMENTS [a1; a] s
                 /\ read events s = e)
               (\s:x86state.
                 read RIP s = returnaddress
                 /\ read RSP s = word_add stackpointer (word 8 : int64)
                 /\ (?e2:((64 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events a1 a pc stackpointer returnaddress
                      /\ memaccess_inbounds e2 [a, 1024; a1, 1024; a, 1024; stackpointer, 8]
                           [a1, 1024; a, 1024; stackpointer, 8]))
               (\s:x86state s':x86state. T)

theorem mldsa_poly_decompose_32_avx2_asm MLDSA_POLY_DECOMPOSE_32_SUBROUTINE_CORRECT
  |- !a1:int64 a:int64 x:(num -> int32) pc:num stackpointer:int64 returnaddress:int64.
       aligned 32 a1
       /\ aligned 32 a
       /\ ALL (nonoverlapping ((word pc : int64), LENGTH mldsa_decompose32_mc)) [a1, 1024; a, 1024]
       /\ nonoverlapping (a1, 1024) (a, 1024)
       /\ nonoverlapping (stackpointer, 8) (a1, 1024)
       /\ nonoverlapping (stackpointer, 8) (a, 1024)
       ==> ensures x86
             (\s:x86state.
