# mldsa_poly_use_hint_32_rv32im_asm
#
# The main theorems. Written by `hol-trace outline` or `hol-trace
# compare --accept`. This is what the proof claims.

theorem mldsa_poly_use_hint_32_rv32im_asm MLDSA_POLY_USE_HINT_32_SUBROUTINE_CORRECT
  |- !a:int32 h:int32 x:(num -> int32) y:(num -> int32) pc:num returnaddress:int32.
       aligned 4 a
       /\ aligned 4 h
       /\ aligned 4 returnaddress
       /\ nonoverlapping (a, 1024) (h, 1024)
       /\ nonoverlapping ((word pc : int32), LENGTH mldsa_poly_use_hint_32_mc) (a, 1024)
       /\ (!i:num. i < 256 ==> val (x i) < 8380417)
       /\ (!i:num. i < 256 ==> val (y i) <= 1)
       ==> ensures riscv
             (\s:riscvstate.
               aligned_bytes_loaded s (word pc : int32) mldsa_poly_use_hint_32_mc
               /\ read PC s = (word pc : int32)
               /\ read RA s = returnaddress
               /\ C_ARGUMENTS [a; h] s
               /\ (!i:num.
                    i < 256
                    ==> read (memory :> bytes32 (word_add a (word (4 * i) : int32))) s = x i)
               /\ (!i:num.
                    i < 256
                    ==> read (memory :> bytes32 (word_add h (word (4 * i) : int32))) s = y i))
             (\s:riscvstate.
               read PC s = returnaddress
               /\ (!i:num.
                    i < 256
                    ==> val (read (memory :> bytes32 (word_add a (word (4 * i) : int32))) s)
                        = mldsa_use_hint_32 (val (y i)) (val (x i))))
             (MAYCHANGE_REGS_PERMITTED_BY_ABI ,, MAYCHANGE [memory :> bytes (a, 1024)])

theorem mldsa_poly_use_hint_32_rv32im_asm MLDSA_POLY_USE_HINT_32_SUBROUTINE_SAFE
  |- ?f_events:(int32 -> int32 -> num -> int32 -> (32 address_uarch_event) list).
       !e:((32 address_uarch_event) list) a:int32 h:int32 pc:num returnaddress:int32.
         aligned 4 a
         /\ aligned 4 h
         /\ aligned 4 returnaddress
         /\ nonoverlapping (a, 1024) (h, 1024)
         /\ nonoverlapping ((word pc : int32), LENGTH mldsa_poly_use_hint_32_mc) (a, 1024)
         ==> ensures riscv
               (\s:riscvstate.
                 aligned_bytes_loaded s (word pc : int32) mldsa_poly_use_hint_32_mc
                 /\ read PC s = (word pc : int32)
                 /\ read RA s = returnaddress
                 /\ C_ARGUMENTS [a; h] s
                 /\ read events s = e)
               (\s:riscvstate.
                 read PC s = returnaddress
                 /\ (?e2:((32 address_uarch_event) list).
                      read events s = APPEND e2 e
                      /\ e2 = f_events h a pc returnaddress
                      /\ memaccess_inbounds e2 [a, 1024; h, 1024] [a, 1024]))
               (\s:riscvstate s':riscvstate. T)
