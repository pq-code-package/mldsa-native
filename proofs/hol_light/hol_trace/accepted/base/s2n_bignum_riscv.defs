definition riscv_gpr
  |- riscv_gpr
     = (specification "riscv_gpr" riscv_gpr:(5 word -> (riscvstate, int32) component).
         !n:(5 word).
           riscv_gpr n
           = COND (n = (word 0 : 5 word)) ZERO (COND (n = (word 1 : 5 word)) RA
               (COND (n = (word 2 : 5 word)) SP (COND (n = (word 3 : 5 word)) GP
                 (COND (n = (word 4 : 5 word)) TP (COND (n = (word 5 : 5 word)) T0
                   (COND (n = (word 6 : 5 word)) T1
                     (COND (n = (word 7 : 5 word)) T2
                       (COND (n = (word 8 : 5 word)) S0
                         (COND (n = (word 9 : 5 word)) S1
                           (COND (n = (word 10 : 5 word)) A0
                             (COND (n = (word 11 : 5 word)) A1
                               (COND (n = (word 12 : 5 word)) A2
                                 (COND (n = (word 13 : 5 word)) A3
                                   (COND (n = (word 14 : 5 word)) A4
                                     (COND (n = (word 15 : 5 word)) A5
                                       (COND (n = (word 16 : 5 word)) A6
                                         (COND (n = (word 17 : 5 word)) A7
                                           (COND (n = (word 18 : 5 word)) S2
                                             (COND (n = (word 19 : 5 word)) S3
                                               (COND (n = (word 20 : 5 word)) S4
                                                 (COND (n = (word 21 : 5 word)) S5
                                                   (COND (n = (word 22 : 5 word)) S6
                                                     (COND (n = (word 23 : 5 word)) S7
                                                       (COND (n = (word 24 : 5 word)) S8
                                                         (COND (n = (word 25 : 5 word)) S9
                                                           (COND (n = (word 26 : 5 word)) S10
                                                             (COND (n = (word 27 : 5 word)) S11
                                                               (COND (n = (word 28 : 5 word)) T3
                                                                 (COND (n = (word 29 : 5 word)) T4
                                                                   (COND (n = (word 30 : 5 word)) T5
                                                                     T6)))))))))))))))))))))))))))))))

definition riscv_addr
  |- riscv_addr
     = (\_1:((riscvstate, int32) component) _2:int32 _3:riscvstate. word_add (read _1 _3) _2)

definition riscv_instruction_pc
  |- riscv_instruction_pc = (\_1:riscvstate. word_sub (read PC _1) (word 4 : int32))

definition riscv_branch_target
  |- riscv_branch_target = (\_1:int32 _2:riscvstate. word_add (riscv_instruction_pc _2) _1)

definition riscv_mulh
  |- riscv_mulh
     = (\_1:int32 _2:int32.
         (word_subword (word_mul (word_sx _1 : int64) (word_sx _2 : int64)) (32, 32) : int32))

definition riscv_event_load
  |- riscv_event_load
     = (\_1:int32 _2:num _3:riscvstate. := events (CONS (EventLoad (_1, _2)) (read events _3)))

definition riscv_event_store
  |- riscv_event_store
     = (\_1:int32 _2:num _3:riscvstate. := events (CONS (EventStore (_1, _2)) (read events _3)))

definition riscv_event_jump
  |- riscv_event_jump
     = (\_1:int32 _2:int32 _3:riscvstate. := events (CONS (EventJump (_1, _2)) (read events _3)))

definition riscv_ADD
  |- riscv_ADD
     = (specification "riscv_ADD" riscv_ADD:((riscvstate, int32) component ->
           (riscvstate, int32) component -> (riscvstate, int32) component -> riscvstate ->
           riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component)
          rs2:((riscvstate, int32) component).
           riscv_ADD rd rs1 rs2
           = (\s:riscvstate.
               let m:int32 = read rs1 s
               and n:int32 = read rs2 s in
               let d:int32 = word_add m n in := rd d s))

definition riscv_ADDI
  |- riscv_ADDI
     = (specification "riscv_ADDI" riscv_ADDI:((riscvstate, int32) component ->
           (riscvstate, int32) component -> int32 -> riscvstate -> riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component) imm:int32.
           riscv_ADDI rd rs1 imm
           = (\s:riscvstate. let m:int32 = read rs1 s in let d:int32 = word_add m imm in := rd d s))

definition riscv_SUB
  |- riscv_SUB
     = (specification "riscv_SUB" riscv_SUB:((riscvstate, int32) component ->
           (riscvstate, int32) component -> (riscvstate, int32) component -> riscvstate ->
           riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component)
          rs2:((riscvstate, int32) component).
           riscv_SUB rd rs1 rs2
           = (\s:riscvstate.
               let m:int32 = read rs1 s
               and n:int32 = read rs2 s in
               let d:int32 = word_sub m n in := rd d s))

definition riscv_SLLI
  |- riscv_SLLI
     = (specification "riscv_SLLI" riscv_SLLI:((riscvstate, int32) component ->
           (riscvstate, int32) component -> num -> riscvstate -> riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component) shamt:num.
           riscv_SLLI rd rs1 shamt
           = (\s:riscvstate.
               let m:int32 = read rs1 s in let d:int32 = word_shl m shamt in := rd d s))

definition riscv_SRAI
  |- riscv_SRAI
     = (specification "riscv_SRAI" riscv_SRAI:((riscvstate, int32) component ->
           (riscvstate, int32) component -> num -> riscvstate -> riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component) shamt:num.
           riscv_SRAI rd rs1 shamt
           = (\s:riscvstate.
               let m:int32 = read rs1 s in let d:int32 = word_ishr m shamt in := rd d s))

definition riscv_LUI
  |- riscv_LUI
     = (specification "riscv_LUI" riscv_LUI:((riscvstate, int32) component -> int32 -> riscvstate ->
           riscvstate -> bool).
         !rd:((riscvstate, int32) component) imm:int32.
           riscv_LUI rd imm = (\s:riscvstate. := rd imm s))

definition riscv_MUL
  |- riscv_MUL
     = (specification "riscv_MUL" riscv_MUL:((riscvstate, int32) component ->
           (riscvstate, int32) component -> (riscvstate, int32) component -> riscvstate ->
           riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component)
          rs2:((riscvstate, int32) component).
           riscv_MUL rd rs1 rs2
           = (\s:riscvstate.
               let m:int32 = read rs1 s
               and n:int32 = read rs2 s in
               let d:int32 = word_mul m n in := rd d s))

definition riscv_MULH
  |- riscv_MULH
     = (specification "riscv_MULH" riscv_MULH:((riscvstate, int32) component ->
           (riscvstate, int32) component -> (riscvstate, int32) component -> riscvstate ->
           riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component)
          rs2:((riscvstate, int32) component).
           riscv_MULH rd rs1 rs2
           = (\s:riscvstate.
               let m:int32 = read rs1 s
               and n:int32 = read rs2 s in
               let d:int32 = riscv_mulh m n in := rd d s))

definition riscv_LW
  |- riscv_LW
     = (specification "riscv_LW" riscv_LW:((riscvstate, int32) component ->
           (riscvstate, int32) component -> int32 -> riscvstate -> riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component) imm:int32.
           riscv_LW rd rs1 imm
           = (\s:riscvstate.
               let addr:int32 = riscv_addr rs1 imm s in
               COND (aligned 4 addr)
                 (:= rd (read (memory :> bytes32 addr) s) ,, riscv_event_load addr 4 s)
                 (ASSIGNS (entirety : (riscvstate, riscvstate) component))
                 s))

definition riscv_SW
  |- riscv_SW
     = (specification "riscv_SW" riscv_SW:((riscvstate, int32) component ->
           (riscvstate, int32) component -> int32 -> riscvstate -> riscvstate -> bool).
         !rs2:((riscvstate, int32) component) rs1:((riscvstate, int32) component) imm:int32.
           riscv_SW rs2 rs1 imm
           = (\s:riscvstate.
               let addr:int32 = riscv_addr rs1 imm s in
               COND (aligned 4 addr)
                 (:= (memory :> bytes32 addr) (read rs2 s) ,, riscv_event_store addr 4 s)
                 (ASSIGNS (entirety : (riscvstate, riscvstate) component))
                 s))

definition riscv_BNE
  |- (riscv_BNE : (riscvstate, '?1) component -> (riscvstate, '?1) component -> int32 ->
         riscvstate -> riscvstate -> bool)
     = (specification "riscv_BNE" riscv_BNE:((riscvstate, '?1) component ->
           (riscvstate, '?1) component -> int32 -> riscvstate -> riscvstate -> bool).
         !rs1:((riscvstate, '?1) component) rs2:((riscvstate, '?1) component) imm:int32.
           riscv_BNE rs1 rs2 imm
           = (\s:riscvstate.
               let src:int32 = riscv_instruction_pc s in
               let dst:int32 =
                   COND (read rs1 s = read rs2 s) (read PC s) (riscv_branch_target imm s) in
               COND (aligned 4 dst) (:= PC dst ,, riscv_event_jump src dst s)
                 (ASSIGNS (entirety : (riscvstate, riscvstate) component))
                 s))

definition riscv_JALR
  |- riscv_JALR
     = (specification "riscv_JALR" riscv_JALR:((riscvstate, int32) component ->
           (riscvstate, int32) component -> int32 -> riscvstate -> riscvstate -> bool).
         !rd:((riscvstate, int32) component) rs1:((riscvstate, int32) component) imm:int32.
           riscv_JALR rd rs1 imm
           = (\s:riscvstate.
               let src:int32 = riscv_instruction_pc s in
               let link:int32 = read PC s in
               let dst:int32 = word_and (riscv_addr rs1 imm s) (word_not (word 1 : int32)) in
               COND (aligned 4 dst) (:= rd link ,, := PC dst ,, riscv_event_jump src dst s)
                 (ASSIGNS (entirety : (riscvstate, riscvstate) component))
                 s))

definition riscv_xreg
  |- riscv_xreg = (\_1:(5 word). riscv_gpr _1)

