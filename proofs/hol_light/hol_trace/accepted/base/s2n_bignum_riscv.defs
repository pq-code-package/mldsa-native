     = (\_1:('N word -> 'N word -> 'N word). simd2 (simd8 _1))

definition _BITMATCH
  |- (_BITMATCH : 'N word -> (num -> '?1 -> bool) -> '?1)
     = (\_1:('N word) _2:(num -> '?1 -> bool). _MATCH (val _1) _2)

definition _ELSEPATTERN
  |- (_ELSEPATTERN : 'B -> 'A -> 'B -> bool) = (\_1:'B _2:'A x:'B. _1 = x)

definition pat_size
  |- pat_size = (\_1:bitpat. FST (dest_bitpat _1))

definition pat_set
  |- pat_set = (\_1:bitpat. SND (dest_bitpat _1))

definition NILPAT
  |- NILPAT = mk_bitpat (0, (\s:num. s = 0))

definition CONSPAT
  |- (CONSPAT : bitpat -> 'N word -> bitpat)
     = (\_1:bitpat _2:('N word).
         let n:num = dimindex (UNIV : 'N -> bool) in
         mk_bitpat (n + pat_size _1, (\s:num. ?t:num. pat_set _1 t /\ s = val _2 + 2 EXP n * t)))

definition word1
  |- word1 = (\_1:bool. (word (bitval _1) : 1 word))

definition pat_extract
  |- pat_extract = (\_1:bitpat _2:num _3:bool. !n:num. pat_set _1 n ==> numbit _2 n = _3)

definition bitpat_inverts
  |- (bitpat_inverts : bitpat -> (num -> 'A) -> 'A -> bool)
     = (\_1:bitpat _2:(num -> 'A) _3:'A. !y:num. pat_set _1 y ==> _2 y = _3)

definition bitpat_down
  |- (bitpat_down : ('N -> bool) -> (num -> 'A) -> num -> 'A)
     = (\_1:('N -> bool) _2:(num -> 'A) _3:num. _2 (_3 DIV 2 EXP dimindex _1))

definition read
  |- (read : ('S, 'V) component -> 'S -> 'V) = (\_1:(('S, 'V) component). FST (dest_component _1))

definition write
  |- (write : ('S, 'V) component -> 'V -> 'S -> 'S)
     = (\_1:(('S, 'V) component). SND (dest_component _1))

definition entirety
  |- (entirety : ('S, 'S) component) = component ((\s:'S. s), (\x:'S s:'S. x))

definition ":>"
  |- ((:>) : ('S, 'T) component -> ('T, 'U) component -> ('S, 'U) component)
     = (\_1:(('S, 'T) component) _2:(('T, 'U) component).
         component (read _2 o read _1, (\v:'U s:'S. write _1 (write _2 v (read _1 s)) s)))

definition read_over_write
  |- (read_over_write : ('S, 'A) component -> bool)
     = (\_1:(('S, 'A) component). !y:'A s:'S. read _1 (write _1 y s) = y)

definition write_over_write
  |- (write_over_write : ('S, 'A) component -> bool)
     = (\_1:(('S, 'A) component). !y:'A z:'A s:'S. write _1 z (write _1 y s) = write _1 z s)

definition write_over_read
  |- (write_over_read : ('S, 'A) component -> bool)
     = (\_1:(('S, 'A) component). !s:'S. write _1 (read _1 s) s = s)

definition weak_read_over_write
  |- (weak_read_over_write : ('S, 'A) component -> bool)
     = (\_1:(('S, 'A) component). ?f:('A -> 'A). !y:'A s:'S. read _1 (write _1 y s) = f y)

definition valid_component
  |- (valid_component : ('?1, '?2) component -> bool)
     = (specification "valid_component" valid_component:(('?1, '?2) component -> bool).
         !c:(('?1, '?2) component).
           valid_component c
           = ((!y:'?2 s:'?1. read c (write c y s) = y)
             /\ (!y:'?2 z:'?2 s:'?1. write c z (write c y s) = write c z s)))

definition weakly_valid_component
  |- (weakly_valid_component : ('?1, '?2) component -> bool)
     = (specification "weakly_valid_component" weakly_valid_component:(('?1, '?2) component ->
           bool).
         !c:(('?1, '?2) component).
           weakly_valid_component c
           = ((?f:('?2 -> '?2). !y:'?2 s:'?1. read c (write c y s) = f y)
             /\ (!y:'?2 z:'?2 s:'?1. write c z (write c y s) = write c z s)))

definition strongly_valid_component
  |- (strongly_valid_component : ('?1, '?2) component -> bool)
     = (specification "strongly_valid_component" strongly_valid_component:(('?1, '?2) component ->
           bool).
         !c:(('?1, '?2) component).
           strongly_valid_component c
           = ((!y:'?2 s:'?1. read c (write c y s) = y)
             /\ (!s:'?1. write c (read c s) s = s)
             /\ (!y:'?2 z:'?2 s:'?1. write c z (write c y s) = write c z s)))

definition extensionally_valid_component
  |- (extensionally_valid_component : ('S, 'A) component -> bool)
     = (specification "extensionally_valid_component"
         extensionally_valid_component:(('S, 'A) component -> bool).
         !c:(('S, 'A) component).
           extensionally_valid_component c
           = ((?f:('A -> 'A). !y:'A s:'S. read c (write c y s) = f y)
             /\ (!s:'S. write c (read c s) s = s)
             /\ (!y:'A z:'A s:'S. write c z (write c y s) = write c z s)))

definition orthogonal_components
  |- (orthogonal_components : ('?1, '?2) component -> ('?1, '?3) component -> bool)
     = (specification "orthogonal_components" orthogonal_components:(('?1, '?2) component ->
           ('?1, '?3) component -> bool).
         !sc1:(('?1, '?2) component) sc2:(('?1, '?3) component).
           orthogonal_components sc1 sc2
           = ((!y:'?2 z:'?3 s:'?1. write sc1 y (write sc2 z s) = write sc2 z (write sc1 y s))
             /\ (!y:'?2 s:'?1. read sc2 (write sc1 y s) = read sc2 s)
             /\ (!z:'?3 s:'?1. read sc1 (write sc2 z s) = read sc1 s)))

definition nonoverlapping_modulo
  |- nonoverlapping_modulo
     = (\_1:num _2:(num # num) _3:(num # num).
         ~ (?i:num j:num. i < SND _2 /\ j < SND _3 /\ ((FST _2 + i) == (FST _3 + j)) (num_mod _1)))

definition contained_modulo
  |- contained_modulo
     = (\_1:num _2:(num # num) _3:(num # num).
         !i:num. i < SND _2 ==> (?j:num. j < SND _3 /\ ((FST _2 + i) == (FST _3 + j)) (num_mod _1)))

definition nonoverlapping
  |- (nonoverlapping : 'N word # num -> 'N word # num -> bool)
     = (\_1:('N word # num) _2:('N word # num).
         nonoverlapping_modulo (2 EXP dimindex (UNIV : 'N -> bool)) (val (FST _1), SND _1)
           (val (FST _2), SND _2))

definition contained
  |- (contained : 'N word # num -> 'N word # num -> bool)
     = (\_1:('N word # num) _2:('N word # num).
         contained_modulo (2 EXP dimindex (UNIV : 'N -> bool)) (val (FST _1), SND _1)
           (val (FST _2), SND _2))

definition is_some
  |- (is_some : 'A option -> bool)
     = (specification "is_some" is_some:('A option -> bool).
         is_some (NONE : 'A option) = F /\ (!a:'A. is_some (SOME a) = T))

definition >>=
  |- (>>= : 'A option -> ('A -> 'B option) -> 'B option)
     = (specification ">>=" ">>=":('A option -> ('A -> 'B option) -> 'B option).
         (!f:('A -> 'B option). ">>=" (NONE : 'A option) f = (NONE : 'B option))
         /\ (!f:('A -> 'B option) a:'A. ">>=" (SOME a) f = f a))

definition from_bitlist
  |- from_bitlist
     = (specification "from_bitlist" from_bitlist:(bool list -> num).
         from_bitlist (NIL : bool list) = 0
         /\ (!b:bool t:(bool list).
              from_bitlist (CONS b t) = COND b (BIT1 (from_bitlist t)) (BIT0 (from_bitlist t))))

definition num_of_bytelist
  |- num_of_bytelist
     = (specification "num_of_bytelist" num_of_bytelist:(byte list -> num).
         num_of_bytelist (NIL : byte list) = 0
         /\ (!h:byte t:(byte list). num_of_bytelist (CONS h t) = val h + 256 * num_of_bytelist t))

definition bytelist_of_num
  |- bytelist_of_num
     = (specification "bytelist_of_num" bytelist_of_num:(num -> num -> byte list).
         (!n:num. bytelist_of_num 0 n = (NIL : byte list))
         /\ (!k:num n:num.
              bytelist_of_num (SUC k) n
              = CONS (word (n MOD 256) : byte) (bytelist_of_num k (n DIV 256))))

definition bytelist_of_int
  |- bytelist_of_int
     = (specification "bytelist_of_int" bytelist_of_int:(num -> int -> byte list).
         !k:num n:int.
           bytelist_of_int k n = bytelist_of_num k (num_of_int (n rem int_of_num (256 EXP k))))

definition read_word_n
  |- read_word_n
     = (specification "read_word_n" read_word_n:(num -> byte list -> (num # byte list) option).
         (!l:(byte list). read_word_n 0 l = SOME (0, l))
         /\ (!n:num. read_word_n (SUC n) (NIL : byte list) = (NONE : (num # byte list) option))
         /\ (!n:num b:byte l:(byte list).
              read_word_n (SUC n) (CONS b l)
              = >>= (read_word_n n l) (GABS (\f:(num # byte list -> (num # byte list) option).
                  !r:num l:(byte list). GEQ (f (r, l)) (SOME (val b + 2 EXP 8 * r, l))))))

definition read_word
  |- (read_word : num -> byte list -> ('N word # byte list) option)
     = (\_1:num _2:(byte list).
         >>= (read_word_n _1 _2) (GABS (\f:(num # byte list -> ('N word # byte list) option).
           !r:num l:(byte list). GEQ (f (r, l)) (SOME ((word r : 'N word), l)))))

definition read_byte
  |- read_byte = (read_word 1 : byte list -> (byte # byte list) option)

definition read_int16
  |- read_int16 = (read_word 2 : byte list -> (int16 # byte list) option)

definition read_int32
  |- read_int32 = (read_word 4 : byte list -> (int32 # byte list) option)

definition read_int64
  |- read_int64 = (read_word 8 : byte list -> (int64 # byte list) option)

definition msimd2
  |- (msimd2 : ('M word -> 'N word -> 'N word -> 'N word) -> ('M tybit0) word -> ('N tybit0) word ->
         ('N tybit0) word -> ('N tybit0) word)
     = (\_1:('M word -> 'N word -> 'N word -> 'N word) _2:(('M tybit0) word) _3:(('N tybit0) word)
         _4:(('N tybit0) word).
         (word_join
           (_1
             (word_subword _2 (dimindex (UNIV : 'M -> bool), dimindex (UNIV : 'M -> bool))
               : 'M word)
             (word_subword _3 (dimindex (UNIV : 'N -> bool), dimindex (UNIV : 'N -> bool))
               : 'N word)
             (word_subword _4 (dimindex (UNIV : 'N -> bool), dimindex (UNIV : 'N -> bool))
               : 'N word))
           (_1 (word_subword _2 (0, dimindex (UNIV : 'M -> bool)) : 'M word)
             (word_subword _3 (0, dimindex (UNIV : 'N -> bool)) : 'N word)
             (word_subword _4 (0, dimindex (UNIV : 'N -> bool)) : 'N word))
           : ('N tybit0) word))

definition msimd4
  |- (msimd4 : ('M word -> 'N word -> 'N word -> 'N word) -> (('M tybit0) tybit0) word ->
         (('N tybit0) tybit0) word -> (('N tybit0) tybit0) word -> (('N tybit0) tybit0) word)
     = (\_1:('M word -> 'N word -> 'N word -> 'N word). msimd2 (msimd2 _1))

definition msimd8
  |- (msimd8 : ('M word -> 'N word -> 'N word -> 'N word) -> ((('M tybit0) tybit0) tybit0) word ->
         ((('N tybit0) tybit0) tybit0) word -> ((('N tybit0) tybit0) tybit0) word ->
         ((('N tybit0) tybit0) tybit0) word)
     = (\_1:('M word -> 'N word -> 'N word -> 'N word). msimd2 (msimd4 _1))

definition msimd16
  |- (msimd16 : ('M word -> 'N word -> 'N word -> 'N word) ->
         (((('M tybit0) tybit0) tybit0) tybit0) word ->
         (((('N tybit0) tybit0) tybit0) tybit0) word ->
         (((('N tybit0) tybit0) tybit0) tybit0) word -> (((('N tybit0) tybit0) tybit0) tybit0) word)
     = (\_1:('M word -> 'N word -> 'N word -> 'N word). msimd2 (msimd8 _1))

definition simd32
  |- (simd32 : ('N word -> 'N word -> 'N word) ->
         ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word ->
         ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word ->
         ((((('N tybit0) tybit0) tybit0) tybit0) tybit0) word)
     = (\_1:('N word -> 'N word -> 'N word). simd2 (simd16 _1))

definition rational
  |- rational
     = (\_1:real.
         ?m:real n:real. integer m /\ integer n /\ ~ (n = real_of_num 0) /\ _1 = real_div m n)

definition floor
  |- floor
     = (specification "floor" n:(real -> real).
         ?r:(real -> real).
           !x:real.
             integer (n x)
             /\ real_le (real_of_num 0) (r x)
             /\ real_lt (r x) (real_of_num 1)
             /\ x = real_add (n x) (r x))

definition frac
  |- frac
     = (specification "frac" r:(real -> real).
         !x:real.
           integer (floor x)
           /\ real_le (real_of_num 0) (r x)
           /\ real_lt (r x) (real_of_num 1)
           /\ x = real_add (floor x) (r x))

definition SUB_LIST
  |- (SUB_LIST : num # num -> '?1 list -> '?1 list)
     = (specification "SUB_LIST" SUB_LIST:(num # num -> '?1 list -> '?1 list).
         (!l:('?1 list). SUB_LIST (0, 0) l = (NIL : '?1 list))
         /\ (!m:num n:num. SUB_LIST (SUC m, n) (NIL : '?1 list) = (NIL : '?1 list))
         /\ (!n:num. SUB_LIST (0, SUC n) (NIL : '?1 list) = (NIL : '?1 list))
         /\ (!n:num h:'?1 t:('?1 list). SUB_LIST (0, SUC n) (CONS h t) = CONS h (SUB_LIST (0, n) t))
         /\ (!m:num n:num h:'?1 t:('?1 list). SUB_LIST (SUC m, n) (CONS h t) = SUB_LIST (m, n) t))

definition TRIM_LIST
  |- (TRIM_LIST : num # num -> '?1 list -> '?1 list)
     = (specification "TRIM_LIST" TRIM_LIST:(num # num -> '?1 list -> '?1 list).
         !h:num t:num l:('?1 list). TRIM_LIST (h, t) l = SUB_LIST (h, LENGTH l - (h + t)) l)

definition limb
  |- limb = (\_1:num _2:num _3:num. _2 DIV 2 EXP (_1 * _3) MOD 2 EXP _1)

definition codelength
  |- codelength = (\_1:(byte list). LENGTH _1)

definition word_interleave
  |- (word_interleave : num -> ('N word) list -> 'M word)
     = (specification "word_interleave" word_interleave:(num -> ('N word) list -> 'M word).
         !n:num inps:(('N word) list).
           word_interleave n inps
           = (let l:num = LENGTH inps in
             (word_of_bits
               (GSPEC (\"GEN%PVAR%1":num.
                 ?i:num.
                   SETSPEC "GEN%PVAR%1"
                     (let q:num = i DIV n
                     and r:num = i MOD n in
                     bit (n * q DIV l + r) (EL (q MOD l) inps))
                     i))
               : 'M word)))

definition word_subdeinterleave
  |- (word_subdeinterleave : num -> num -> 'M word -> num -> 'N word)
     = (specification "word_subdeinterleave" word_subdeinterleave:(num -> num -> 'M word -> num ->
           'N word).
         !l:num n:num z:('M word) j:num.
           word_subdeinterleave l n z j
           = (word_of_bits
               (GSPEC (\"GEN%PVAR%1":num.
                 ?i:num.
                   SETSPEC "GEN%PVAR%1"
                     (let q:num = i DIV n and r:num = i MOD n in bit ((l * q + j) * n + r) z)
                     i))
               : 'N word))

definition word_deinterleave
  |- (word_deinterleave : num -> num -> 'M word -> ('N word) list)
     = (specification "word_deinterleave" word_deinterleave:(num -> num -> 'M word ->
           ('N word) list).
         !l:num n:num z:('M word).
           word_deinterleave l n z = list_of_seq (word_subdeinterleave l n z : num -> 'N word) l)

definition word_condense
  |- (word_condense : 'N word -> 'N word -> 'N word)
     = (specification "word_condense" word_condense:('N word -> 'N word -> 'N word).
         !x:('N word) y:('N word).
           word_condense x y
           = (word
               (nsum
                 (GSPEC (\"GEN%PVAR%1":num.
                   ?i:num. SETSPEC "GEN%PVAR%1" (i < dimindex (UNIV : 'N -> bool)) i))
                 (\i:num.
                   2 EXP word_popcount (word_and y (word (2 EXP i - 1) : 'N word))
                   * bitval (bit i (word_and x y))))
               : 'N word))

definition num_condense
  |- num_condense
     = (specification "num_condense" num_condense:(num -> num -> num).
         !n:num m:num.
           num_condense n m
           = COND (m = 0 \/ n = 0) 0 (COND (EVEN m) (num_condense (n DIV 2) (m DIV 2))
               (2 * num_condense (n DIV 2) (m DIV 2) + bitval (ODD n))))

definition ENUMERATEL
  |- (ENUMERATEL : num -> (num -> 'A list) -> 'A list)
     = (specification "ENUMERATEL" ENUMERATEL:(num -> (num -> 'A list) -> 'A list).
         (!f:(num -> 'A list). ENUMERATEL 0 f = (NIL : 'A list))
         /\ (!n:num f:(num -> 'A list). ENUMERATEL (SUC n) f = APPEND (f n) (ENUMERATEL n f)))

definition evaluate
  |- (evaluate : ('A -> 'B) -> ('A, 'B) component)
     = (specification "evaluate" evaluate:(('A -> 'B) -> ('A, 'B) component).
         !f:('A -> 'B). evaluate f = component (f, (\y:'B x:'A. x)))

definition rvalue
  |- (rvalue : '?1 -> ('?2, '?1) component)
     = (specification "rvalue" rvalue:('?1 -> ('?2, '?1) component).
         !c:'?1. rvalue c = component ((\s:'?2. c), (\d:'?1 s:'?2. s)))

definition through
  |- (through : ('?1 -> '?2) # ('?2 -> '?1) -> ('?1, '?2) component)
     = (specification "through" through:(('?1 -> '?2) # ('?2 -> '?1) -> ('?1, '?2) component).
         !f:('?1 -> '?2) g:('?2 -> '?1). through (f, g) = component (f, (\x:'?2 s:'?1. g x)))

definition asnumber
  |- (asnumber : ('N word, num) component)
     = (specification "asnumber" asnumber:(('N word, num) component).
         asnumber = through ((val : 'N word -> num), (word : num -> 'N word)))

definition asword
  |- (asword : (num, 'N word) component)
     = (specification "asword" asword:((num, 'N word) component).
         asword = through ((word : num -> 'N word), (val : 'N word -> num)))

definition element
  |- (element : 'I -> ('I -> 'V, 'V) component)
     = (\_1:'I. component ((\s:('I -> 'V). s _1), (\v:'V s:('I -> 'V) j:'I. COND (j = _1) v (s j))))

definition bitelement
  |- (bitelement : num -> ('N word, bool) component)
     = (\_1:num.
         component ((\x:('N word). bit _1 x)
         , (\b:bool x:('N word).
             COND b (word_of_bits (INSERT _1 (bits_of_word x)) : 'N word)
               (word_of_bits (DELETE (bits_of_word x) _1) : 'N word))))

definition subword
  |- (subword : num # num -> ('N word, 'M word) component)
     = (specification "subword" subword:(num # num -> ('N word, 'M word) component).
         !pos:num len:num.
           subword (pos, len)
           = component ((\w:('N word). (word (val w DIV 2 EXP pos MOD 2 EXP len) : 'M word))
             , (\v:('M word) w:('N word).
                 (word
                   (2 EXP (pos + len) * val w DIV 2 EXP (pos + len)
                   + 2 EXP pos * val v MOD 2 EXP len
                   + val w MOD 2 EXP pos)
                   : 'N word))))

definition bottomhalf
  |- (bottomhalf : (('N tybit0) word, 'N word) component)
     = (specification "bottomhalf" bottomhalf:((('N tybit0) word, 'N word) component).
         bottomhalf
         = (subword (0, dimindex (UNIV : 'N -> bool)) : (('N tybit0) word, 'N word) component))

definition tophalf
  |- (tophalf : (('N tybit0) word, 'N word) component)
     = (specification "tophalf" tophalf:((('N tybit0) word, 'N word) component).
         tophalf
         = (subword (dimindex (UNIV : 'N -> bool), dimindex (UNIV : 'N -> bool))
             : (('N tybit0) word, 'N word) component))

definition bottom_256
  |- bottom_256
     = (specification "bottom_256" bottom_256:((512 word, 256 word) component).
         bottom_256 = (bottomhalf : (512 word, 256 word) component))

definition top_256
  |- top_256
     = (specification "top_256" top_256:((512 word, 256 word) component).
         top_256 = (tophalf : (512 word, 256 word) component))

definition bottom_128
  |- bottom_128
     = (specification "bottom_128" bottom_128:((256 word, int128) component).
         bottom_128 = (bottomhalf : (256 word, int128) component))

definition top_128
  |- top_128
     = (specification "top_128" top_128:((256 word, int128) component).
         top_128 = (tophalf : (256 word, int128) component))

definition bottom_64
  |- bottom_64
     = (specification "bottom_64" bottom_64:((int128, int64) component).
         bottom_64 = (bottomhalf : (int128, int64) component))

definition top_64
  |- top_64
     = (specification "top_64" top_64:((int128, int64) component).
         top_64 = (tophalf : (int128, int64) component))

definition bottom_32
  |- bottom_32
     = (specification "bottom_32" bottom_32:((int64, int32) component).
         bottom_32 = (bottomhalf : (int64, int32) component))

definition top_32
  |- top_32
     = (specification "top_32" top_32:((int64, int32) component).
         top_32 = (tophalf : (int64, int32) component))

definition bottom_16
  |- bottom_16
     = (specification "bottom_16" bottom_16:((int32, int16) component).
         bottom_16 = (bottomhalf : (int32, int16) component))

definition top_16
  |- top_16
     = (specification "top_16" top_16:((int32, int16) component).
         top_16 = (tophalf : (int32, int16) component))

definition bottom_8
  |- bottom_8
     = (specification "bottom_8" bottom_8:((int16, byte) component).
         bottom_8 = (bottomhalf : (int16, byte) component))

definition top_8
  |- top_8
     = (specification "top_8" top_8:((int16, byte) component).
         top_8 = (tophalf : (int16, byte) component))

definition zerotop_32
  |- zerotop_32 = through ((word_zx : int64 -> int32), (word_zx : int32 -> int64))

definition zerotop_64
  |- zerotop_64 = through ((word_zx : int128 -> int64), (word_zx : int64 -> int128))

definition zerotop_16
  |- zerotop_16 = through ((word_zx : int32 -> int16), (word_zx : int16 -> int32))

definition zerotop_8
  |- zerotop_8 = through ((word_zx : int16 -> byte), (word_zx : byte -> int16))

definition zerotop_128
  |- zerotop_128 = through ((word_zx : 256 word -> int128), (word_zx : int128 -> 256 word))

definition zerotop_256
  |- zerotop_256 = through ((word_zx : 512 word -> 256 word), (word_zx : 256 word -> 512 word))

definition bytes
  |- (bytes : 'A word # num -> ('A word -> byte, num) component)
     = (specification "bytes" bytes:('A word # num -> ('A word -> byte, num) component).
         (!a:('A word) s:('A word -> byte). read (bytes (a, 0)) s = 0)
         /\ (!a:('A word) k:num s:('A word -> byte).
              read (bytes (a, SUC k)) s
              = read (bytes (a, k)) s + 2 EXP (8 * k) * val (s (word_add a (word k : 'A word))))
         /\ (!a:('A word) s:('A word -> byte) n:num. write (bytes (a, 0)) n s = s)
         /\ (!a:('A word) k:num s:('A word -> byte) n:num.
              write (bytes (a, SUC k)) n s
              = write (bytes (a, k)) n (write
                  (element (word_add a (word k : 'A word)) : ('A word -> byte, byte) component)
                  (word (limb 8 n k) : byte)
                  s)))

definition bytelist
  |- (bytelist : '?1 word # num -> ('?1 word -> byte, byte list) component)
     = (specification "bytelist" bytelist:('?1 word # num ->
           ('?1 word -> byte, byte list) component).
         !a:('?1 word) n:num.
           bytelist (a, n) = bytes (a, n) :> through (bytelist_of_num n, num_of_bytelist))

definition wbytes
  |- (wbytes : 'A word -> ('A word -> byte, 'N word) component)
     = (\_1:('A word).
         bytes (_1, dimindex (UNIV : 'N -> bool) DIV 8) :> (asword : (num, 'N word) component))

definition bytes8
  |- (bytes8 : 'A word -> ('A word -> byte, byte) component)
     = (specification "bytes8" bytes8:('A word -> ('A word -> byte, byte) component).
         !addr:('A word). bytes8 addr = bytes (addr, 1) :> (asword : (num, byte) component))

definition bytes16
  |- (bytes16 : 'A word -> ('A word -> byte, int16) component)
     = (specification "bytes16" bytes16:('A word -> ('A word -> byte, int16) component).
         !addr:('A word). bytes16 addr = bytes (addr, 2) :> (asword : (num, int16) component))

definition bytes32
  |- (bytes32 : 'A word -> ('A word -> byte, int32) component)
     = (specification "bytes32" bytes32:('A word -> ('A word -> byte, int32) component).
         !addr:('A word). bytes32 addr = bytes (addr, 4) :> (asword : (num, int32) component))

definition bytes64
  |- (bytes64 : 'A word -> ('A word -> byte, int64) component)
     = (specification "bytes64" bytes64:('A word -> ('A word -> byte, int64) component).
         !addr:('A word). bytes64 addr = bytes (addr, 8) :> (asword : (num, int64) component))

definition bytes128
  |- (bytes128 : 'A word -> ('A word -> byte, int128) component)
     = (specification "bytes128" bytes128:('A word -> ('A word -> byte, int128) component).
         !addr:('A word). bytes128 addr = bytes (addr, 16) :> (asword : (num, int128) component))

definition bytes256
  |- (bytes256 : 'A word -> ('A word -> byte, 256 word) component)
     = (specification "bytes256" bytes256:('A word -> ('A word -> byte, 256 word) component).
         !addr:('A word). bytes256 addr = bytes (addr, 32) :> (asword : (num, 256 word) component))

definition top
  |- (top : ('?1 list, '?1) component)
     = component ((\l:('?1 list). HD l), (\h:'?1 l:('?1 list). CONS h (TL l)))

definition |->
  |- (|-> : 'A -> 'B -> ('A -> 'B) -> 'A -> 'B)
     = (\_1:'A _2:'B _3:('A -> 'B) y:'A. COND (y = _1) _2 (_3 y))

definition ,,
  |- ((,,) : ('B -> 'C -> bool) -> ('C -> 'A -> bool) -> 'B -> 'A -> bool)
     = (\_1:('B -> 'C -> bool) _2:('C -> 'A -> bool) s0:'B s2:'A. ?s1:'C. _1 s0 s1 /\ _2 s1 s2)

definition subsumed
  |- (subsumed : ('A -> 'B -> bool) -> ('A -> 'B -> bool) -> bool)
     = (\_1:('A -> 'B -> bool) _2:('A -> 'B -> bool). !x:'A y:'B. _1 x y ==> _2 x y)

definition ":="
  |- (:= : ('A, 'V) component -> 'V -> 'A -> 'A -> bool)
     = (\_1:(('A, 'V) component) _2:'V s:'A s':'A. write _1 _2 s = s')

definition ASSIGNS
  |- (ASSIGNS : ('A, 'B) component -> 'A -> 'A -> bool)
     = (\_1:(('A, 'B) component) _2:'A _3:'A. ?y:'B. := _1 y _2 _3)

definition VIA
  |- (VIA : ('S, 'V) component -> ('V -> 'V -> bool) -> 'S -> 'S -> bool)
     = (specification "VIA" VIA:(('S, 'V) component -> ('V -> 'V -> bool) -> 'S -> 'S -> bool).
         !c:(('S, 'V) component) R:('V -> 'V -> bool).
           VIA c R = (\s1:'S s2:'S. ?y:'V. R (read c s1) y /\ := c y s1 s2))

definition modify
  |- (modify : ('S, 'V) component -> ('V -> 'V) -> 'S -> 'S)
     = (specification "modify" modify:(('S, 'V) component -> ('V -> 'V) -> 'S -> 'S).
         !c:(('S, 'V) component) f:('V -> 'V). modify c f = (\s:'S. write c (f (read c s)) s))

definition MAYCHANGE
  |- (MAYCHANGE : (('A, 'B) component) list -> 'A -> 'A -> bool)
     = (specification "MAYCHANGE" MAYCHANGE:((('A, 'B) component) list -> 'A -> 'A -> bool).
         MAYCHANGE (NIL : (('A, 'B) component) list) = ((=) : 'A -> 'A -> bool)
         /\ (!c:(('A, 'B) component) cs:((('A, 'B) component) list).
              MAYCHANGE (CONS c cs) = ASSIGNS c ,, MAYCHANGE cs))

definition UNDEFINED_VALUE
  |- (UNDEFINED_VALUE : ('A, 'B) component -> 'A -> 'A -> bool)
     = (ASSIGNS : ('A, 'B) component -> 'A -> 'A -> bool)

definition UNDEFINED_VALUES
  |- (UNDEFINED_VALUES : (('A, 'B) component) list -> 'A -> 'A -> bool)
     = (specification "UNDEFINED_VALUES" UNDEFINED_VALUES:((('A, 'B) component) list -> 'A -> 'A ->
           bool).
         UNDEFINED_VALUES (NIL : (('A, 'B) component) list) = ((=) : 'A -> 'A -> bool)
         /\ (!c:(('A, 'B) component) cs:((('A, 'B) component) list).
              UNDEFINED_VALUES (CONS c cs) = ASSIGNS c ,, UNDEFINED_VALUES cs))

definition eventually
  |- (eventually : ('A -> 'A -> bool) -> ('A -> bool) -> 'A -> bool)
     = (\step:('A -> 'A -> bool) P:('A -> bool) a:'A.
         !eventually':('A -> bool).
           (!a:'A.
             P a \/ (?s':'A. step a s') /\ (!s':'A. step a s' ==> eventually' s') ==> eventually' a)
           ==> eventually' a)

definition hoare
  |- (hoare : ('A -> 'A -> bool) -> ('A -> bool) -> ('A -> bool) -> bool)
     = (specification "hoare" hoare:(('A -> 'A -> bool) -> ('A -> bool) -> ('A -> bool) -> bool).
         !step:('A -> 'A -> bool) pre:('A -> bool) post:('A -> bool).
           hoare step pre post = (!s:'A. pre s ==> eventually step post s))

definition ensures
  |- (ensures : ('A -> 'A -> bool) -> ('A -> bool) -> ('A -> bool) -> ('A -> 'A -> bool) -> bool)
     = (specification "ensures" ensures:(('A -> 'A -> bool) -> ('A -> bool) -> ('A -> bool) ->
           ('A -> 'A -> bool) -> bool).
         !step:('A -> 'A -> bool) precondition:('A -> bool) postcondition:('A -> bool)
          frame:('A -> 'A -> bool).
           ensures step precondition postcondition frame
           = (!s:'A. precondition s ==> eventually step (\s':'A. postcondition s' /\ frame s s') s))

definition steps
  |- (steps : ('S -> 'S -> bool) -> num -> 'S -> 'S -> bool)
     = (\step:('S -> 'S -> bool) a0:num a1:'S a2:'S.
         !steps':(num -> 'S -> 'S -> bool).
           (!a0:num a1:'S a2:'S.
             a0 = 0 /\ a2 = a1 \/ (?n:num. a0 = n + 1 /\ (?s':'S. step a1 s' /\ steps' n s' a2))
             ==> steps' a0 a1 a2)
           ==> steps' a0 a1 a2)

definition eventually_n
  |- (eventually_n : ('S -> 'S -> bool) -> num -> ('S -> bool) -> 'S -> bool)
     = (\_1:('S -> 'S -> bool) _2:num _3:('S -> bool) _4:'S.
         (!s':'S. steps _1 _2 _4 s' ==> _3 s')
         /\ (!s':'S n':num. n' < _2 /\ steps _1 n' _4 s' ==> (?s'':'S. _1 s' s'')))

definition ensures_n
  |- (ensures_n : ('S -> 'S -> bool) -> ('S -> bool) -> ('S -> bool) -> ('S -> 'S -> bool) ->
         ('S -> num) -> bool)
     = (\_1:('S -> 'S -> bool) _2:('S -> bool) _3:('S -> bool) _4:('S -> 'S -> bool) _5:('S -> num).
         !s:'S. _2 s ==> eventually_n _1 (_5 s) (\s':'S. _3 s' /\ _4 s s') s)

definition _<EventLoad>
  |- (_<EventLoad> : 'A word # num -> 'A address_uarch_event)
     = (\a:('A word # num).
         _mk_address_uarch_event ((\a:('A word # num).
           CONSTR 0
             (a, (@v:('A word # 'A word). T), (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
             (\n:num.
               (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 #
                   num) recspace))) a))

definition _<EventStore>
  |- (_<EventStore> : 'A word # num -> 'A address_uarch_event)
     = (\a:('A word # num).
         _mk_address_uarch_event ((\a:('A word # num).
           CONSTR (SUC 0)
             (a, (@v:('A word # 'A word). T), (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
             (\n:num.
               (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 #
                   num) recspace))) a))

definition _<EventJump>
  |- (_<EventJump> : 'A word # 'A word -> 'A address_uarch_event)
     = (\a:('A word # 'A word).
         _mk_address_uarch_event ((\a:('A word # 'A word).
           CONSTR (SUC (SUC 0))
             ((@v:('A word # num). T), a, (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
             (\n:num.
               (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 #
                   num) recspace))) a))

definition _<EventX86PEXT>
  |- (_<EventX86PEXT> : int64 # int64 # num -> 'A address_uarch_event)
     = (\a:(int64 # int64 # num).
         _mk_address_uarch_event ((\a:(int64 # int64 # num).
           CONSTR (SUC (SUC (SUC 0)))
             ((@v:('A word # num). T), (@v:('A word # 'A word). T), a, (@v:(int64 # num). T))
             (\n:num.
               (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 #
                   num) recspace))) a))

definition _<EventX86POPCNT>
  |- (_<EventX86POPCNT> : int64 # num -> 'A address_uarch_event)
     = (\a:(int64 # num).
         _mk_address_uarch_event ((\a:(int64 # num).
           CONSTR (SUC (SUC (SUC (SUC 0))))
             ((@v:('A word # num). T)
             , (@v:('A word # 'A word). T), (@v:(int64 # int64 # num). T), a)
             (\n:num.
               (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 #
                   num) recspace))) a))

definition EventLoad
  |- (EventLoad : 'A word # num -> 'A address_uarch_event)
     = (_<EventLoad> : 'A word # num -> 'A address_uarch_event)

definition EventStore
  |- (EventStore : 'A word # num -> 'A address_uarch_event)
     = (_<EventStore> : 'A word # num -> 'A address_uarch_event)

definition EventJump
  |- (EventJump : 'A word # 'A word -> 'A address_uarch_event)
     = (_<EventJump> : 'A word # 'A word -> 'A address_uarch_event)

definition EventX86PEXT
  |- (EventX86PEXT : int64 # int64 # num -> 'A address_uarch_event)
     = (_<EventX86PEXT> : int64 # int64 # num -> 'A address_uarch_event)

definition EventX86POPCNT
  |- (EventX86POPCNT : int64 # num -> 'A address_uarch_event)
     = (_<EventX86POPCNT> : int64 # num -> 'A address_uarch_event)

definition memaccess_inbounds
  |- (memaccess_inbounds : ('A address_uarch_event) list -> ('A word # num) list ->
         ('A word # num) list -> bool)
     = (\_1:(('A address_uarch_event) list) _2:(('A word # num) list) _3:(('A word # num) list).
         ALL
           (\e:('A address_uarch_event).
             _MATCH e (_SEQPATTERN
               (\"GEN%PVAR%1":('A address_uarch_event) "GEN%PVAR%2":bool.
                 ?adr:('A word) sz:num.
                   _UNGUARDED_PATTERN (GEQ (EventLoad (adr, sz)) "GEN%PVAR%1")
                     (GEQ
                       (EX
                         (\range:('A word # num).
                           contained_modulo (2 EXP dimindex (UNIV : 'A -> bool)) (val adr, sz)
                             (val (FST range), SND range))
                         _2)
                       "GEN%PVAR%2"))
               (_SEQPATTERN
                 (\"GEN%PVAR%3":('A address_uarch_event) "GEN%PVAR%4":bool.
                   ?adr:('A word) sz:num.
                     _UNGUARDED_PATTERN (GEQ (EventStore (adr, sz)) "GEN%PVAR%3")
                       (GEQ
                         (EX
                           (\range:('A word # num).
                             contained_modulo (2 EXP dimindex (UNIV : 'A -> bool)) (val adr, sz)
                               (val (FST range), SND range))
                           _3)
                         "GEN%PVAR%4"))
                 (\"GEN%PVAR%5":('A address_uarch_event) "GEN%PVAR%6":bool.
                   ?_:('A address_uarch_event).
                     _UNGUARDED_PATTERN (GEQ _ "GEN%PVAR%5") (GEQ T "GEN%PVAR%6")))))
           _1)

definition _<riscvstate_RECORD>
  |- _<riscvstate_RECORD>
     = (\a0:int32 a1:(5 word -> int32) a2:(int32 -> byte) a3:((32 address_uarch_event) list).
         _mk_riscvstate ((\a0:int32 a1:(5 word -> int32) a2:(int32 -> byte)
                           a3:((32 address_uarch_event) list).
           CONSTR 0 (a0, a1, a2, a3) (\n:num.
             (BOTTOM : (int32 # (5 word -> int32) # (int32 -> byte) # (32 address_uarch_event) list)
               recspace))) a0 a1 a2 a3))

definition riscvstate_RECORD
  |- riscvstate_RECORD = _<riscvstate_RECORD>

definition PC
  |- PC
     = (specification "PC" c:((riscvstate, int32) component).
         (!a0:int32 a1:(5 word -> int32) a2:(int32 -> byte) a3:((32 address_uarch_event) list).
           read c (riscvstate_RECORD a0 a1 a2 a3) = a0)
         /\ (!a0':int32 a0:int32 a1:(5 word -> int32) a2:(int32 -> byte)
              a3:((32 address_uarch_event) list).
              write c a0' (riscvstate_RECORD a0 a1 a2 a3) = riscvstate_RECORD a0' a1 a2 a3))

definition registers
  |- registers
     = (specification "registers" c:((riscvstate, 5 word -> int32) component).
         (!a0:int32 a1:(5 word -> int32) a2:(int32 -> byte) a3:((32 address_uarch_event) list).
           read c (riscvstate_RECORD a0 a1 a2 a3) = a1)
         /\ (!a1':(5 word -> int32) a0:int32 a1:(5 word -> int32) a2:(int32 -> byte)
              a3:((32 address_uarch_event) list).
              write c a1' (riscvstate_RECORD a0 a1 a2 a3) = riscvstate_RECORD a0 a1' a2 a3))

definition memory
  |- memory
     = (specification "memory" c:((riscvstate, int32 -> byte) component).
         (!a0:int32 a1:(5 word -> int32) a2:(int32 -> byte) a3:((32 address_uarch_event) list).
           read c (riscvstate_RECORD a0 a1 a2 a3) = a2)
         /\ (!a2':(int32 -> byte) a0:int32 a1:(5 word -> int32) a2:(int32 -> byte)
              a3:((32 address_uarch_event) list).
              write c a2' (riscvstate_RECORD a0 a1 a2 a3) = riscvstate_RECORD a0 a1 a2' a3))

definition events
  |- events
     = (specification "events" c:((riscvstate, (32 address_uarch_event) list) component).
         (!a0:int32 a1:(5 word -> int32) a2:(int32 -> byte) a3:((32 address_uarch_event) list).
           read c (riscvstate_RECORD a0 a1 a2 a3) = a3)
         /\ (!a3':((32 address_uarch_event) list) a0:int32 a1:(5 word -> int32) a2:(int32 -> byte)
              a3:((32 address_uarch_event) list).
              write c a3' (riscvstate_RECORD a0 a1 a2 a3) = riscvstate_RECORD a0 a1 a2 a3'))

definition bytes_loaded
  |- bytes_loaded
     = (\_1:riscvstate _2:int32 _3:(byte list). read (memory :> bytelist (_2, LENGTH _3)) _1 = _3)

definition aligned_bytes_loaded
  |- aligned_bytes_loaded
     = (\_1:riscvstate _2:int32 _3:(byte list). num_divides 4 (val _2) /\ bytes_loaded _1 _2 _3)

definition XREG
  |- XREG
     = (specification "XREG" XREG:(num -> (riscvstate, int32) component).
         !n:num.
           XREG n = registers :> (element (word n : 5 word) : (5 word -> int32, int32) component))

definition X0
  |- X0
     = (specification "X0" X0:((riscvstate, int32) component).
         X0 = (rvalue (word 0 : int32) : (riscvstate, int32) component))

definition X1
  |- X1 = (specification "X1" X1:((riscvstate, int32) component). X1 = XREG 1)

definition X2
  |- X2 = (specification "X2" X2:((riscvstate, int32) component). X2 = XREG 2)

