                   (_SEQPATTERN
                     (\"BM%PVAR%10":num "BM%PVAR%11":((riscvstate -> riscvstate -> bool) option).
                       ?shamt:(5 word) rs1:(5 word) rd:(5 word).
                         _UNGUARDED_PATTERN
                           (pat_set
                             (CONSPAT
                               (CONSPAT
                                 (CONSPAT
                                   (CONSPAT (CONSPAT (CONSPAT NILPAT (word 0 : 7 word)) shamt) rs1)
                                   (word 1 : 3 word))
                                 rd)
                               (word 19 : 7 word))
                             "BM%PVAR%10")
                           (SOME (riscv_SLLI (riscv_xreg rd) (riscv_xreg rs1) (val shamt))
                           = "BM%PVAR%11"))
                     (_SEQPATTERN
                       (\"BM%PVAR%10":num "BM%PVAR%11":((riscvstate -> riscvstate -> bool) option).
                         ?shamt:(5 word) rs1:(5 word) rd:(5 word).
                           _UNGUARDED_PATTERN
                             (pat_set
                               (CONSPAT
                                 (CONSPAT
                                   (CONSPAT
                                     (CONSPAT (CONSPAT (CONSPAT NILPAT (word 32 : 7 word)) shamt)
                                       rs1)
                                     (word 5 : 3 word))
                                   rd)
                                 (word 19 : 7 word))
                               "BM%PVAR%10")
                             (SOME (riscv_SRAI (riscv_xreg rd) (riscv_xreg rs1) (val shamt))
                             = "BM%PVAR%11"))
                       (_SEQPATTERN
                         (\"BM%PVAR%10":num
                           "BM%PVAR%11":((riscvstate -> riscvstate -> bool) option).
                           ?imm:(12 word) rs1:(5 word) rd:(5 word).
                             _UNGUARDED_PATTERN
                               (pat_set
                                 (CONSPAT
                                   (CONSPAT
                                     (CONSPAT (CONSPAT (CONSPAT NILPAT imm) rs1) (word 2 : 3 word))
                                     rd)
                                   (word 3 : 7 word))
                                 "BM%PVAR%10")
                               (SOME (riscv_LW (riscv_xreg rd) (riscv_xreg rs1)
                                 (word_sx imm : int32))
                               = "BM%PVAR%11"))
                         (_SEQPATTERN
                           (\"BM%PVAR%10":num
                             "BM%PVAR%11":((riscvstate -> riscvstate -> bool) option).
                             ?immhi:(7 word) rs2:(5 word) rs1:(5 word) immlo:(5 word).
                               _UNGUARDED_PATTERN
                                 (pat_set
                                   (CONSPAT
                                     (CONSPAT
                                       (CONSPAT (CONSPAT (CONSPAT (CONSPAT NILPAT immhi) rs2) rs1)
                                         (word 2 : 3 word))
                                       immlo)
                                     (word 35 : 7 word))
                                   "BM%PVAR%10")
                                 (SOME (riscv_SW (riscv_xreg rs2) (riscv_xreg rs1)
                                   (word_sx (word_join immhi immlo : 12 word) : int32))
                                 = "BM%PVAR%11"))
                           (_SEQPATTERN
                             (\"BM%PVAR%10":num
                               "BM%PVAR%11":((riscvstate -> riscvstate -> bool) option).
                               ?imm12:(1 word) imm10_5:(6 word) rs2:(5 word) rs1:(5 word)
                                imm4_1:(4 word) imm11:(1 word).
                                 _UNGUARDED_PATTERN
                                   (pat_set
                                     (CONSPAT
                                       (CONSPAT
                                         (CONSPAT
                                           (CONSPAT
                                             (CONSPAT
                                               (CONSPAT (CONSPAT (CONSPAT NILPAT imm12) imm10_5)
                                                 rs2)
                                               rs1)
                                             (word 1 : 3 word))
                                           imm4_1)
                                         imm11)
                                       (word 99 : 7 word))
                                     "BM%PVAR%10")
                                   (SOME (riscv_BNE (riscv_xreg rs1) (riscv_xreg rs2)
                                     (word_sx
                                       (word_join
                                         (word_join (word_join imm12 imm11 : 2 word) imm10_5 : byte)
                                         (word_join imm4_1 (word 0 : 1 word) : 5 word)
                                         : 13 word)
                                       : int32))
                                   = "BM%PVAR%11"))
                             (_SEQPATTERN
                               (\"BM%PVAR%10":num
                                 "BM%PVAR%11":((riscvstate -> riscvstate -> bool) option).
                                 ?imm:(20 word) rd:(5 word).
                                   _UNGUARDED_PATTERN
                                     (pat_set
                                       (CONSPAT (CONSPAT (CONSPAT NILPAT imm) rd)
                                         (word 55 : 7 word))
                                       "BM%PVAR%10")
                                     (SOME (riscv_LUI (riscv_xreg rd)
                                       (word_join imm (word 0 : 12 word) : int32))
                                     = "BM%PVAR%11"))
                               (_SEQPATTERN
                                 (\"BM%PVAR%10":num
                                   "BM%PVAR%11":((riscvstate -> riscvstate -> bool) option).
                                   ?imm:(12 word) rs1:(5 word) rd:(5 word).
                                     _UNGUARDED_PATTERN
                                       (pat_set
                                         (CONSPAT
                                           (CONSPAT
                                             (CONSPAT (CONSPAT (CONSPAT NILPAT imm) rs1)
                                               (word 0 : 3 word))
                                             rd)
                                           (word 103 : 7 word))
                                         "BM%PVAR%10")
                                       (SOME (riscv_JALR (riscv_xreg rd) (riscv_xreg rs1)
                                         (word_sx imm : int32))
                                       = "BM%PVAR%11"))
                                 (_ELSEPATTERN (NONE : (riscvstate -> riscvstate -> bool) option)
                                   : num -> (riscvstate -> riscvstate -> bool) option ->
                                       bool))))))))))))))

definition decode32
  |- (decode32 : (int32 -> '?1 option) -> riscvstate -> int32 -> '?1 -> bool)
     = (\_1:(int32 -> '?1 option) _2:riscvstate _3:int32 _4:'?1.
         ?i:int32. aligned_bytes_loaded _2 _3 (bytelist_of_num 4 (val i)) /\ _1 i = SOME _4)

definition riscv_decode
  |- riscv_decode
     = (\_1:riscvstate _2:int32 _3:(riscvstate -> riscvstate -> bool). decode32 decode _1 _2 _3)

definition riscv_execute
  |- riscv_execute
     = (specification "riscv_execute" riscv_execute:((riscvstate -> riscvstate -> bool) ->
           riscvstate -> riscvstate -> bool).
         riscv_execute = (\i:(riscvstate -> riscvstate -> bool). i))

definition riscv
  |- riscv
     = (specification "riscv" riscv:(riscvstate -> riscvstate -> bool).
         !s:riscvstate s':riscvstate.
           riscv s s'
           = (?instr:(riscvstate -> riscvstate -> bool).
               riscv_decode s (read PC s) instr
               /\ (,,) (:= PC (word_add (read PC s) (word 4 : int32))) (riscv_execute instr) s s'))

definition SOME_FLAGS
  |- SOME_FLAGS = (NIL : ((riscvstate, bool) component) list)

definition C_ARGUMENTS
  |- C_ARGUMENTS
     = (specification "C_ARGUMENTS" C_ARGUMENTS:(int32 list -> riscvstate -> bool).
         (!a1:int32 a2:int32 a3:int32 a4:int32 a5:int32 a6:int32 a7:int32 a8:int32 s:riscvstate.
           C_ARGUMENTS [a1; a2; a3; a4; a5; a6; a7; a8] s
           = (read A0 s = a1
             /\ read A1 s = a2
             /\ read A2 s = a3
             /\ read A3 s = a4
             /\ read A4 s = a5
             /\ read A5 s = a6
             /\ read A6 s = a7
             /\ read A7 s = a8))
         /\ (!a1:int32 a2:int32 a3:int32 a4:int32 a5:int32 a6:int32 a7:int32 s:riscvstate.
              C_ARGUMENTS [a1; a2; a3; a4; a5; a6; a7] s
              = (read A0 s = a1
                /\ read A1 s = a2
                /\ read A2 s = a3
                /\ read A3 s = a4
                /\ read A4 s = a5
                /\ read A5 s = a6
                /\ read A6 s = a7))
         /\ (!a1:int32 a2:int32 a3:int32 a4:int32 a5:int32 a6:int32 s:riscvstate.
              C_ARGUMENTS [a1; a2; a3; a4; a5; a6] s
              = (read A0 s = a1
                /\ read A1 s = a2
                /\ read A2 s = a3
                /\ read A3 s = a4
                /\ read A4 s = a5
                /\ read A5 s = a6))
         /\ (!a1:int32 a2:int32 a3:int32 a4:int32 a5:int32 s:riscvstate.
              C_ARGUMENTS [a1; a2; a3; a4; a5] s
              = (read A0 s = a1
                /\ read A1 s = a2
                /\ read A2 s = a3
                /\ read A3 s = a4
                /\ read A4 s = a5))
         /\ (!a1:int32 a2:int32 a3:int32 a4:int32 s:riscvstate.
              C_ARGUMENTS [a1; a2; a3; a4] s
              = (read A0 s = a1 /\ read A1 s = a2 /\ read A2 s = a3 /\ read A3 s = a4))
         /\ (!a1:int32 a2:int32 a3:int32 s:riscvstate.
              C_ARGUMENTS [a1; a2; a3] s = (read A0 s = a1 /\ read A1 s = a2 /\ read A2 s = a3))
         /\ (!a1:int32 a2:int32 s:riscvstate.
              C_ARGUMENTS [a1; a2] s = (read A0 s = a1 /\ read A1 s = a2))
         /\ (!a1:int32 s:riscvstate. C_ARGUMENTS [a1] s = (read A0 s = a1))
         /\ (!s:riscvstate. C_ARGUMENTS (NIL : int32 list) s = T))

definition C_RETURN
  |- C_RETURN = (specification "C_RETURN" C_RETURN:(riscvstate -> int32). C_RETURN = read A0)

definition PRESERVED_GPRS
  |- PRESERVED_GPRS
     = (specification "PRESERVED_GPRS" PRESERVED_GPRS:(((riscvstate, int32) component) list).
         PRESERVED_GPRS = [SP; S0; S1; S2; S3; S4; S5; S6; S7; S8; S9; S10; S11])

definition MODIFIABLE_GPRS
  |- MODIFIABLE_GPRS
     = (specification "MODIFIABLE_GPRS" MODIFIABLE_GPRS:(((riscvstate, int32) component) list).
         MODIFIABLE_GPRS = [RA; A0; A1; A2; A3; A4; A5; A6; A7; T0; T1; T2; T3; T4; T5; T6])

definition MAYCHANGE_REGS_PERMITTED_BY_ABI
  |- MAYCHANGE_REGS_PERMITTED_BY_ABI
     = MAYCHANGE [PC] ,, MAYCHANGE MODIFIABLE_GPRS ,, MAYCHANGE [events]

definition num_of_wordlist
  |- (num_of_wordlist : ('N word) list -> num)
     = (specification "num_of_wordlist" num_of_wordlist:(('N word) list -> num).
         num_of_wordlist (NIL : ('N word) list) = 0
         /\ (!h:('N word) t:(('N word) list).
              num_of_wordlist (CONS h t)
              = val h + 2 EXP dimindex (UNIV : 'N -> bool) * num_of_wordlist t))

definition wordlist_of_num
  |- (wordlist_of_num : num -> num -> ('N word) list)
     = (specification "wordlist_of_num" wordlist_of_num:(num -> num -> ('N word) list).
         (!n:num. wordlist_of_num 0 n = (NIL : ('N word) list))
         /\ (!k:num n:num.
              wordlist_of_num (SUC k) n
              = CONS (word (n MOD 2 EXP dimindex (UNIV : 'N -> bool)) : 'N word)
                  (wordlist_of_num k (n DIV 2 EXP dimindex (UNIV : 'N -> bool)))))

definition wordlist_from_memory
  |- (wordlist_from_memory : int32 # num -> riscvstate -> ('N word) list)
     = (specification "wordlist_from_memory" wordlist_from_memory:(int32 # num -> riscvstate ->
           ('N word) list).
         !a:int32 n:num s:riscvstate.
           wordlist_from_memory (a, n) s
           = (wordlist_of_num n
               (read (memory :> bytes (a, (dimindex (UNIV : 'N -> bool) * n + 7) DIV 8)) s)
               : ('N word) list))

definition pair_wordlist
  |- (pair_wordlist : ('N word) list -> (('N tybit0) word) list)
     = (specification "pair_wordlist" pair_wordlist:(('N word) list -> (('N tybit0) word) list).
         (!hi:('N word) lo:('N word) rest:(('N word) list).
           pair_wordlist (CONS lo (CONS hi rest))
           = CONS (word_join hi lo : ('N tybit0) word) (pair_wordlist rest))
         /\ (!w:('N word).
              pair_wordlist [w] = [(word_join (word 0 : 'N word) w : ('N tybit0) word)])
         /\ pair_wordlist (NIL : ('N word) list) = (NIL : (('N tybit0) word) list))

typedef word
  |- (\x:((bool, 'N) cart). T) {r:(bool, 'N) cart}
     = ((bitvector : 'N word -> (bool, 'N) cart) ((mk_word : (bool, 'N) cart -> 'N word)
         {r:(bool, 'N) cart})
       = {r:(bool, 'N) cart})

typedef bitpat
  |- (\x:(num # (num -> bool)). !a:num. SND x a ==> a < 2 EXP FST x) {r:num # (num -> bool)}
     = ((dest_bitpat : bitpat -> num # (num -> bool))
         ((mk_bitpat : num # (num -> bool) -> bitpat) {r:num # (num -> bool)})
       = {r:num # (num -> bool)})

typedef component
  |- (\rw:(('S -> 'V) # ('V -> 'S -> 'S)). T) {r:('S -> 'V) # ('V -> 'S -> 'S)}
     = ((dest_component : ('S, 'V) component -> ('S -> 'V) # ('V -> 'S -> 'S))
         ((component : ('S -> 'V) # ('V -> 'S -> 'S) -> ('S, 'V) component)
           {r:('S -> 'V) # ('V -> 'S -> 'S)})
       = {r:('S -> 'V) # ('V -> 'S -> 'S)})

typedef address_uarch_event
  |- (\a:((('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num) recspace).
       !address_uarch_event':((('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                int64 # num) recspace -> bool).
         (!a:((('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
             recspace).
           (?a:('A word # num).
             {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
               recspace}
             = (\a:('A word # num).
                 CONSTR 0
                   (a
                   , (@v:('A word # 'A word). T)
                     , (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
                   (\n:num.
                     (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                         int64 # num) recspace))) a)
           \/ (?a:('A word # num).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:('A word # num).
                    CONSTR (SUC 0)
                      (a
                      , (@v:('A word # 'A word). T)
                        , (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           \/ (?a:('A word # 'A word).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:('A word # 'A word).
                    CONSTR (SUC (SUC 0))
                      ((@v:('A word # num). T)
                      , a, (@v:(int64 # int64 # num). T), (@v:(int64 # num). T))
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           \/ (?a:(int64 # int64 # num).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:(int64 # int64 # num).
                    CONSTR (SUC (SUC (SUC 0)))
                      ((@v:('A word # num). T)
                      , (@v:('A word # 'A word). T), a, (@v:(int64 # num). T))
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           \/ (?a:(int64 # num).
                {a:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
                  recspace}
                = (\a:(int64 # num).
                    CONSTR (SUC (SUC (SUC (SUC 0))))
                      ((@v:('A word # num). T)
                      , (@v:('A word # 'A word). T), (@v:(int64 # int64 # num). T), a)
                      (\n:num.
                        (BOTTOM : (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) #
                            int64 # num) recspace))) a)
           ==> address_uarch_event' a)
         ==> address_uarch_event' a) {r:(('A word # num) # ('A word # 'A word) #
         (int64 # int64 # num) # int64 # num) recspace}
     = ((_dest_address_uarch_event : 'A address_uarch_event ->
           (('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num) recspace)
         ((_mk_address_uarch_event : (('A word # num) # ('A word # 'A word) #
                 (int64 # int64 # num) # int64 # num) recspace -> 'A address_uarch_event)
           {r:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num)
             recspace})
       = {r:(('A word # num) # ('A word # 'A word) # (int64 # int64 # num) # int64 # num) recspace})

typedef riscvstate
  |- (\a:((int32 # (5 word -> int32) # (int32 -> byte) # (32 address_uarch_event) list) recspace).
       !riscvstate':((int32 # (5 word -> int32) # (int32 -> byte) # (32 address_uarch_event) list)
              recspace -> bool).
         (!a:((int32 # (5 word -> int32) # (int32 -> byte) # (32 address_uarch_event) list)
             recspace).
           (?a0:int32 a1:(5 word -> int32) a2:(int32 -> byte) a3:((32 address_uarch_event) list).
             a
             = (\a0:int32 a1:(5 word -> int32) a2:(int32 -> byte)
                 a3:((32 address_uarch_event) list).
                 CONSTR 0 (a0, a1, a2, a3) (\n:num.
                   (BOTTOM : (int32 # (5 word -> int32) # (int32 -> byte) #
                       (32 address_uarch_event) list) recspace))) a0 a1 a2 a3)
           ==> riscvstate' a)
         ==> riscvstate' a) {r:(int32 # (5 word -> int32) # (int32 -> byte) #
         (32 address_uarch_event) list) recspace}
     = ((_dest_riscvstate : riscvstate ->
           (int32 # (5 word -> int32) # (int32 -> byte) # (32 address_uarch_event) list) recspace)
         ((_mk_riscvstate : (int32 # (5 word -> int32) # (int32 -> byte) #
                 (32 address_uarch_event) list) recspace -> riscvstate)
           {r:(int32 # (5 word -> int32) # (int32 -> byte) # (32 address_uarch_event) list)
             recspace})
       = {r:(int32 # (5 word -> int32) # (int32 -> byte) # (32 address_uarch_event) list) recspace})
